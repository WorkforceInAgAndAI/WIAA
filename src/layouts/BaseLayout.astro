---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Inspiring future leaders in science who are passionate about using AI and its applications in agricultural related problems." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <title>{title} | WIAA</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --isu-red: #C41E3A;
    --isu-dark-red: #a01830;
    --isu-gold: #FFB81C;
    --isu-light-gold: #ffd93f;
    --bg-light: #fcfbf9;
    --bg-white: #ffffff;
    --text-dark: #333333;
    --text-medium: #555555;
    --text-light: #999999;
    --border-light: #e0e0e0;
    --border-gold: #FFB81C;
  }

  body {
    font-family: Georgia, Garamond, 'Times New Roman', serif;
    background: var(--bg-white);
    color: var(--text-dark);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-weight: 400;
    line-height: 1.7;
  }

  h1, h2, h3, h4, h5, h6 {
    font-weight: 400;
    color: var(--text-dark);
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }

  h1 {
    font-size: 54px;
    line-height: 1.2;
  }

  h2 {
    font-size: 42px;
    line-height: 1.2;
  }

  h3 {
    font-size: 28px;
    line-height: 1.3;
  }

  h4 {
    font-size: 24px;
    line-height: 1.3;
  }

  p {
    font-size: 16px;
    line-height: 1.7;
    margin-bottom: 20px;
  }

  a {
    color: var(--isu-red);
    text-decoration: none;
    transition: color 0.2s;
  }

  a:hover {
    color: var(--isu-dark-red);
  }

  main {
    flex: 1;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

.image-caption {
    text-align: center;
    color: var(--text-medium);
    font-size: 0.9em;
    font-style: italic;
    margin-top: -10px;
    margin-bottom: 20px;
  }

  .btn {
    padding: 12px 28px;
    border: none;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
    text-decoration: none;
    display: inline-block;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }

  .btn-primary {
    background: var(--isu-red);
    color: white;
  }

  .btn-primary:hover {
    background: var(--isu-dark-red);
    color: white;
  }

  .btn-secondary {
    background: var(--isu-gold);
    color: var(--isu-red);
  }

  .btn-secondary:hover {
    background: var(--isu-light-gold);
  }

  /* Mobile responsiveness */
  @media (max-width: 767px) {
    h1 {
      font-size: 36px;
    }

    h2 {
      font-size: 32px;
    }

    h3 {
      font-size: 24px;
    }

    .container {
      padding: 0 25px;
    }
  }
</style>