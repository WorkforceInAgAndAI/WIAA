---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact">
  <div class="container page-content">
    <div class="content-box">
      <h1>Contact WIAA</h1>
      
      <p class="intro">We'd love to hear from you! Whether you're interested in bringing WIAA programming to your school, have questions about our curriculum, or want to collaborate, please reach out.</p>

      <div class="contact-grid">
        <div class="contact-info">
          <h2>Get in Touch</h2>
          
          <div class="contact-item">
            <i class="fas fa-envelope"></i>
            <div>
              <h3>Email</h3>
              <a href="mailto:arti@iastate.edu">arti@iastate.edu</a>
            </div>
          </div>

          <div class="contact-item">
            <i class="fas fa-map-marker-alt"></i>
            <div>
              <h3>Address</h3>
              <p>716 Farm House Lane<br>Ames, Iowa 50011</p>
            </div>
          </div>

          <div class="contact-item">
            <i class="fas fa-university"></i>
            <div>
              <h3>Institution</h3>
              <p>Iowa State University<br>College of Agriculture and Life Sciences</p>
            </div>
          </div>
        </div>

        <div class="contact-form">
          <h2>Send Us a Message</h2>
          <form action="https://formspree.io/f/xykwbyrl" method="POST">
            <div class="form-group">
              <label for="name">Name *</label>
              <input type="text" id="name" name="name" required>
            </div>

            <div class="form-group">
              <label for="email">Email *</label>
              <input type="email" id="email" name="email" required>
            </div>

            <div class="form-group">
              <label for="organization">School/Organization</label>
              <input type="text" id="organization" name="organization">
            </div>

            <div class="form-group">
              <label for="subject">Subject *</label>
              <select id="subject" name="subject" required>
                <option value="">Select a subject...</option>
                <option value="outreach">Request Outreach Program</option>
                <option value="curriculum">Curriculum Questions</option>
                <option value="collaboration">Collaboration Opportunity</option>
                <option value="other">Other Inquiry</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Message *</label>
              <textarea id="message" name="message" rows="6" required></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Send Message</button>
          </form>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .page-content {
    padding: 80px 40px;
  }

  .content-box {
    background: white;
    padding: 60px;
    max-width: 1100px;
    margin: 0 auto;
    border-bottom: 1px solid var(--border-light);
  }

  .content-box h1 {
    margin-bottom: 30px;
    border-bottom: 1px solid var(--border-light);
    padding-bottom: 20px;
    font-size: 54px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--text-dark);
  }

  .intro {
    font-size: 16px;
    color: var(--text-medium);
    line-height: 1.7;
    margin-bottom: 40px;
    font-weight: 400;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    margin-bottom: 40px;
  }

  .contact-info h2,
  .contact-form h2 {
    color: var(--text-dark);
    font-size: 42px;
    margin-bottom: 30px;
    font-weight: 400;
    line-height: 1.2;
  }

  .contact-item {
    display: flex;
    gap: 15px;
    margin-bottom: 25px;
    align-items: start;
  }

  .contact-item i {
    font-size: 20px;
    color: var(--isu-red);
    margin-top: 5px;
    flex-shrink: 0;
  }

  .contact-item h3 {
    font-size: 16px;
    color: var(--text-dark);
    margin: 0 0 8px 0;
    font-weight: 600;
  }

  .contact-item p,
  .contact-item a {
    margin: 0;
    color: var(--text-medium);
    line-height: 1.7;
    font-size: 16px;
  }

  .contact-item a {
    color: var(--isu-red);
  }

  .contact-item a:hover {
    color: var(--isu-dark-red);
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    color: var(--text-dark);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--border-light);
    font-family: Georgia, Garamond, 'Times New Roman', serif;
    font-size: 16px;
    transition: border-color 0.2s;
    color: var(--text-dark);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--isu-red);
  }

  .form-group textarea {
    resize: vertical;
  }

  .info-box {
    background: white;
    padding: 20px;
    border-bottom: 1px solid var(--border-light);
  }

  .info-box h3 {
    color: var(--text-dark);
    margin: 0 0 10px 0;
    font-weight: 600;
    font-size: 16px;
  }

  .info-box p {
    margin: 5px 0;
    color: var(--text-medium);
    font-size: 16px;
  }

  /* Mobile responsiveness */
  @media (max-width: 767px) {
    .page-content {
      padding: 60px 25px;
    }

    .content-box {
      padding: 40px 25px;
    }

    .content-box h1 {
      font-size: 36px;
      margin-bottom: 20px;
      padding-bottom: 15px;
    }

    .contact-info h2,
    .contact-form h2 {
      font-size: 32px;
      margin-bottom: 25px;
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>