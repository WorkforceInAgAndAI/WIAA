---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SatSidebar from '../../../components/SatSidebar.astro';
import SatLessonNav from '../../../components/SatLessonNav.astro';
import SatThresholdDemo from '../../../components/SatThresholdDemo.astro';

const content = await import('../../../content/satellites/09-imagery-pipeline/lesson-5.md');
const { Content } = content;
const { title, chapter, lesson } = content.frontmatter;
---

<BaseLayout title={title}>
  <div class="container" style="max-width: 1400px; margin: 30px auto; padding: 0 20px;">
    <div style="display: grid; grid-template-columns: 250px 1fr; gap: 24px; align-items: start;">
      <SatSidebar currentChapter={chapter} currentLesson={lesson} />
      <div class="content-area">
        <div class="content-header">
          <p class="chapter-label">Chapter {chapter}: Satellite Imagery Processing Pipeline</p>
          <h1>{title}</h1>
        </div>
        <article class="lesson-content">
          <Content />
        </article>
        <SatThresholdDemo />
        <SatLessonNav
          prev={{ href: '/satellites/09-imagery-pipeline/lesson-4', label: 'Previous' }}
          next={{ href: '/satellites/09-imagery-pipeline/lesson-6', label: 'Next' }}
          progress={`${chapter}.${lesson} / 11 Chapters`}
        />
      </div>
    </div>
  </div>
</BaseLayout>
<style is:global>
  :root {
    --isu-red: #c41e3a;
    --isu-gold: #f8c600;
    --border-light: #ddd;
    --text-dark: #1a1a1a;
    --text-medium: #666;
    --isu-dark-red: #a01729;
  }
  .lesson-content p {
    line-height: 1.8;
    color: var(--text-dark);
    margin-bottom: 18px;
  }
  .section-intro {
    font-size: 1.05em;
    color: var(--text-medium);
    font-style: italic;
    margin-bottom: 24px;
  }
  .impact-callout {
    background: linear-gradient(135deg, rgba(196, 30, 58, 0.08) 0%, rgba(255, 184, 28, 0.08) 100%);
    border-left: 5px solid var(--isu-red);
    border-radius: 6px;
    padding: 24px;
    margin-bottom: 30px;
  }
  .impact-callout h4 {
    color: var(--isu-red);
    margin-top: 0;
    margin-bottom: 12px;
    font-size: 1.15em;
  }
  .impact-callout p {
    color: var(--text-dark);
    line-height: 1.7;
    margin: 0;
  }
</style>
<style>
  @media (max-width: 768px) {
    div[style*="grid-template-columns"] {
      display: flex !important;
      flex-direction: column-reverse !important;
      gap: 16px !important;
    }
  }
</style>