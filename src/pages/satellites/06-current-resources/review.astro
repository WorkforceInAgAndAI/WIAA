---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SatSidebar from '../../../components/SatSidebar.astro';
import SatLessonNav from '../../../components/SatLessonNav.astro';
import Quiz from '../../../components/Quiz.astro';
import quizRaw from '../../../../public/data/quizzes/sat-06-current-resources.json?raw';
const quizData = JSON.parse(quizRaw);
const chapter = 6;
const lesson = 3;
---
<BaseLayout title="Concept Review">
  <div class="container" style="max-width: 1400px; margin: 30px auto; padding: 0 20px;">
    <div style="display: grid; grid-template-columns: 250px 1fr; gap: 24px; align-items: start;">
      <SatSidebar currentChapter={chapter} currentLesson={lesson} />
      <div class="content-area">
        <div class="content-header">
          <p class="chapter-label">Chapter {chapter}: Current Satellite Resources</p>
          <h1>Concept Review</h1>
        </div>
        <p>Test your understanding with the quiz below:</p>
        <Quiz questions={quizData} />
        <SatLessonNav
          prev={{ href: '/satellites/06-current-resources/lesson-2', label: 'Previous' }}
          next={{ href: '/satellites/07-vegetation-indices/lesson-1', label: 'Next' }}
          progress={`${chapter}.${lesson} / 11 Chapters`}
        />
      </div>
    </div>
  </div>
</BaseLayout>
<style is:global>
  .lesson-content img {
    max-width: 800px !important;
    height: auto !important;
    display: block !important;
    margin: 20px auto !important;
  }
  @media (max-width: 767px) {
    .lesson-content img {
      max-width: 280px !important;
    }
  }
</style>
<style>
  @media (max-width: 768px) {
    div[style*="grid-template-columns"] {
      display: flex !important;
      flex-direction: column-reverse !important;
      gap: 16px !important;
    }
  }
</style>