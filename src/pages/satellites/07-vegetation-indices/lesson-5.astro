---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SatSidebar from '../../../components/SatSidebar.astro';
import SatLessonNav from '../../../components/SatLessonNav.astro';
import SatScatteringMatch from '../../../components/SatScatteringMatch.astro';
import SatNDVIActivity from '../../../components/SatNDVIActivity.astro';

const content = await import('../../../content/satellites/07-vegetation-indices/lesson-5.md');
const { Content } = content;
const { title, chapter, lesson } = content.frontmatter;
---

<BaseLayout title={title}>
  <div class="container" style="max-width: 1400px; margin: 30px auto; padding: 0 20px;">
    <div style="display: grid; grid-template-columns: 250px 1fr; gap: 24px; align-items: start;">
      <SatSidebar currentChapter={chapter} currentLesson={lesson} />
      <div class="content-area">
        <div class="content-header">
          <p class="chapter-label">Chapter {chapter}: Vegetation Indices and Data Analysis</p>
          <h1>{title}</h1>
        </div>
        <article class="lesson-content">
          <Content />
        </article>

        <hr />
        <h2>Activities: Vegetation Indices and Data Analysis</h2>
        <SatScatteringMatch />
        <p class="ndvi-reminder">Reminder &mdash; NDVI = (NIR &minus; Red) / (NIR + Red)</p>
        <SatNDVIActivity />

        <SatLessonNav
          prev={{ href: '/satellites/07-vegetation-indices/lesson-4', label: 'Previous' }}
          next={{ href: '/satellites/07-vegetation-indices/review', label: 'Next' }}
          progress={`${chapter}.${lesson} / 11 Chapters`}
        />
      </div>
    </div>
  </div>
</BaseLayout>
<style is:global>
  :root {
    --isu-red: #c41e3a;
    --isu-gold: #f8c600;
    --border-light: #ddd;
    --text-dark: #1a1a1a;
    --text-medium: #666;
    --isu-dark-red: #a01729;
  }
  .lesson-content img {
    max-width: 800px !important;
    height: auto !important;
    display: block !important;
    margin: 20px auto !important;
  }
  @media (max-width: 767px) {
    .lesson-content img {
      max-width: 280px !important;
    }
  }
  .lesson-content p {
    line-height: 1.8;
    color: var(--text-dark);
    margin-bottom: 18px;
  }
  .image-caption {
    text-align: center;
    color: var(--text-medium);
    font-size: 0.9em;
    font-style: italic;
    margin-top: -10px;
    margin-bottom: 20px;
  }
  .ndvi-reminder {
    text-align: center;
    color: var(--isu-dark-red);
    font-weight: 600;
    background: #f9f7f4;
    padding: 12px;
    border-radius: 6px;
    margin: -10px 0 10px;
  }
</style>
<style>
  @media (max-width: 768px) {
    div[style*="grid-template-columns"] {
      display: flex !important;
      flex-direction: column-reverse !important;
      gap: 16px !important;
    }
  }
</style>