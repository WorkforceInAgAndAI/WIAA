---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Home">
  <div class="hero-section" style={`--hero-bg: url('${base}/images/Home.jpg')`}>
    <div class="container">
      <h1>Workforce in Agriculture and AI</h1>
      <p>Inspiring future leaders and cultivating a skilled agricultural workforce dedicated to integrating artificial intelligence, science, and engineering to address real-world agricultural challenges.</p>
      <a href={base + '/drones'} class="btn btn-secondary">Start learning about drones</a>
    </div>
  </div>
  
  <div class="container page-content">
    <h2 class="section-title">Featured programs</h2>
    
<div class="program-grid">
      <div class="program-card">
        <h3>Drone program</h3>
        <p>Understand drone parts, sensors, and AI applications in agriculture.</p>
        <a href={base + '/drones'} class="btn btn-primary">Learn More</a>
      </div>

      <div class="program-card">
        <h3>Satellite program</h3>
        <p>Explore satellite technology, data resolution, and AI applications in agriculture.</p>
        <a href={base + '/satellites'} class="btn btn-primary">Learn More</a>
      </div>

      <div class="program-card">
        <h3>Outreach work</h3>
        <p>Previous outreach events and workshops.</p>
        <a href={base + '/outreach'} class="btn btn-primary">Learn More</a>
      </div>
    </div>  </div>
</BaseLayout>

<style>
  .hero-section {
    color: white;
    padding: 80px 40px;
    text-align: center;
    background-size: cover;
    background-position: center;
    position: relative;
    min-height: 500px;
    display: flex;
    align-items: center;
  }
  
  .hero-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(196, 30, 58, 0.75);
    z-index: 1;
  }
  
  .hero-section {
    background-image: var(--hero-bg);
  }
  
  .hero-section > * {
    position: relative;
    z-index: 2;
  }

  .hero-section .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }
  
  .hero-section h1 {
    font-size: 54px;
    font-weight: 400;
    margin-bottom: 30px;
    color: white;
    line-height: 1.2;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }
  
  .hero-section p {
    font-size: 16px;
    max-width: 900px;
    margin: 0 auto 30px;
    line-height: 1.7;
    color: white;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
    font-weight: 400;
  }
  
  .page-content {
    padding: 80px 40px;
  }
  
  .section-title {
    text-align: center;
    margin-bottom: 60px;
    font-size: 42px;
    color: var(--text-dark);
    font-weight: 400;
    line-height: 1.2;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }
  
  .program-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 60px;
    max-width: 900px;
    margin: 0 auto;
  }
  
  .program-card {
    background: white;
    padding: 40px;
    border: 1px solid var(--border-light);
    text-align: center;
  }
  
  .program-card h3 {
    color: var(--text-dark);
    margin-bottom: 15px;
    font-weight: 400;
    font-size: 28px;
    line-height: 1.3;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }
  
  .program-card p {
    margin-bottom: 30px;
    color: var(--text-medium);
    font-size: 16px;
    line-height: 1.7;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
    font-weight: 400;
  }
  
  .coming-soon-text {
    color: var(--text-light);
  }
  
  .btn-disabled {
    background: var(--border-light);
    cursor: not-allowed;
    color: var(--text-light);
  }
  
  /* Mobile responsiveness */
  @media (max-width: 767px) {
    .hero-section {
      padding: 60px 25px;
      min-height: 400px;
    }

    .hero-section .container {
      padding: 0 25px;
    }
    
    .hero-section h1 {
      font-size: 36px;
      margin-bottom: 20px;
    }

    .hero-section p {
      font-size: 16px;
      margin-bottom: 25px;
    }
    
    .page-content {
      padding: 60px 25px;
    }

    .section-title {
      font-size: 32px;
      margin-bottom: 40px;
    }
    
    .program-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .program-card {
      padding: 30px;
    }

    .program-card h3 {
      font-size: 24px;
      margin-bottom: 12px;
    }

    .program-card p {
      margin-bottom: 20px;
    }
  }
</style>