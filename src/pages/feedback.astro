---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Feedback">
  <div class="container page-content">
    <div class="content-box">
      <h1>Share Your Feedback</h1>
      
      <p class="intro">Your feedback helps us improve our programs and create better learning experiences. Whether you're a student, educator, parent, or community partner, we want to hear from you!</p>

      <div class="feedback-categories">
        <div class="category-card">
          <i class="fas fa-graduation-cap"></i>
          <h3>Students</h3>
          <p>Tell us about your experience with our drone and rover programs</p>
        </div>
        <div class="category-card">
          <i class="fas fa-chalkboard-teacher"></i>
          <h3>Educators</h3>
          <p>Share how our curriculum works in your classroom</p>
        </div>
      </div>

      <div class="feedback-form">
        <h2>Feedback Form</h2>
        <form action="https://formspree.io/f/mnjdoqed" method="POST">
          <div class="form-group">
            <label for="name">Name (Optional)</label>
            <input type="text" id="name" name="name">
            <small>You may submit feedback anonymously</small>
          </div>

          <div class="form-group">
            <label for="email">Email (Optional)</label>
            <input type="email" id="email" name="email">
            <small>Only if you'd like us to follow up with you</small>
          </div>

          <div class="form-group">
            <label for="role">I am a... *</label>
            <select id="role" name="role" required>
              <option value="">Select your role...</option>
              <option value="student">Student</option>
              <option value="teacher">Teacher/Educator/Instructor</option>
              <option value="parent">Parent</option>
              <option value="administrator">School Administrator</option>
              <option value="community">Student Leader</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div class="form-group">
            <label for="program">Which program is your feedback about?</label>
            <select id="program" name="program">
              <option value="">Select a program...</option>
              <option value="drones">Drone Program</option>
              <option value="rovers">Rover Program</option>
              <option value="outreach">Outreach Event</option>
              <option value="website">Website/Resources</option>
              <option value="general">General Feedback</option>
            </select>
          </div>

          <div class="form-group">
            <label for="rating">Overall Experience *</label>
            <div class="rating-options">
              <label class="rating-option">
                <input type="radio" name="rating" value="5" required>
                <span>⭐⭐⭐⭐⭐ Excellent</span>
              </label>
              <label class="rating-option">
                <input type="radio" name="rating" value="4" required>
                <span>⭐⭐⭐⭐ Good</span>
              </label>
              <label class="rating-option">
                <input type="radio" name="rating" value="3" required>
                <span>⭐⭐⭐ Fair</span>
              </label>
              <label class="rating-option">
                <input type="radio" name="rating" value="2" required>
                <span>⭐⭐ Poor</span>
              </label>
              <label class="rating-option">
                <input type="radio" name="rating" value="1" required>
                <span>⭐ Very Poor</span>
              </label>
            </div>
          </div>

          <div class="form-group">
            <label for="liked">What did you like most?</label>
            <textarea id="liked" name="liked" rows="4"></textarea>
          </div>

          <div class="form-group">
            <label for="improve">What could we improve?</label>
            <textarea id="improve" name="improve" rows="4"></textarea>
          </div>

          <div class="form-group">
            <label for="additional">Additional Comments</label>
            <textarea id="additional" name="additional" rows="4"></textarea>
          </div>

          <button type="submit" class="btn btn-primary">Submit Feedback</button>
        </form>
      </div>

      <div class="info-box">
        <h3>Your Feedback Matters</h3>
        <p><strong>Thank you for helping us inspire future leaders in science.</strong></p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-content {
    padding: 80px 40px;
  }

  .content-box {
    background: white;
    padding: 60px;
    max-width: 900px;
    margin: 0 auto;
    border-bottom: 1px solid var(--border-light);
  }

  .content-box h1 {
    margin-bottom: 30px;
    border-bottom: 1px solid var(--border-light);
    padding-bottom: 20px;
    font-size: 54px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--text-dark);
  }

  .intro {
    font-size: 16px;
    color: var(--text-medium);
    line-height: 1.7;
    margin-bottom: 40px;
    font-weight: 400;
  }

  .feedback-categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 30px;
    margin-bottom: 40px;
  }

  .category-card {
    text-align: center;
    padding: 30px;
    background: white;
    border: 1px solid var(--border-light);
  }

  .category-card i {
    font-size: 32px;
    color: var(--isu-red);
    margin-bottom: 15px;
    display: block;
  }

  .category-card h3 {
    color: var(--text-dark);
    margin-bottom: 10px;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.3;
  }

  .category-card p {
    font-size: 16px;
    color: var(--text-medium);
    margin: 0;
    line-height: 1.7;
  }

  .feedback-form {
    margin-bottom: 40px;
  }

  .feedback-form h2 {
    color: var(--text-dark);
    font-size: 42px;
    margin-bottom: 30px;
    font-weight: 400;
    line-height: 1.2;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    color: var(--text-dark);
    font-size: 16px;
  }

  .form-group small {
    display: block;
    margin-top: 5px;
    color: var(--text-light);
    font-size: 12px;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--border-light);
    font-family: Georgia, Garamond, 'Times New Roman', serif;
    font-size: 16px;
    transition: border-color 0.2s;
    color: var(--text-dark);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--isu-red);
  }

  .form-group textarea {
    resize: vertical;
  }

  .rating-options {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .rating-option {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border: 1px solid var(--border-light);
    cursor: pointer;
    transition: border-color 0.2s;
    background: white;
  }

  .rating-option:hover {
    background: white;
    border-color: var(--isu-red);
  }

  .rating-option input[type="radio"] {
    width: auto;
    margin: 0;
  }

  .rating-option span {
    font-size: 16px;
    color: var(--text-dark);
  }

  .info-box {
    background: white;
    padding: 30px;
    border: 1px solid var(--border-light);
  }

  .info-box h3 {
    color: var(--text-dark);
    margin: 0 0 15px 0;
    font-weight: 400;
    font-size: 28px;
    line-height: 1.3;
  }

  .info-box p {
    margin: 10px 0;
    color: var(--text-medium);
    font-size: 16px;
    line-height: 1.7;
  }

  .info-box ul {
    margin: 15px 0 15px 20px;
    color: var(--text-medium);
  }

  .info-box li {
    margin-bottom: 15px;
    font-size: 16px;
    line-height: 1.7;
  }

  /* Mobile responsiveness */
  @media (max-width: 767px) {
    .page-content {
      padding: 60px 25px;
    }

    .content-box {
      padding: 40px 25px;
    }

    .content-box h1 {
      font-size: 36px;
      margin-bottom: 20px;
      padding-bottom: 15px;
    }

    .feedback-form h2 {
      font-size: 32px;
      margin-bottom: 25px;
    }

    .feedback-categories {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>