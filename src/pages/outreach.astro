// ─────────────────────────────────────────────
// FULL EVENT TIMELINE — every event, every year
// ─────────────────────────────────────────────
const timelineEvents = [
  { date: "February 2022", title: "ISU Day at the Capitol", attendees: "~100", format: "Displays & Discussions", audience: "Policy Makers" },
  { date: "August 2022", title: "NAPB Field Tours", attendees: "~400", format: "Presentations & Stations", audience: "NAPB Members" },
  { date: "August 2022", title: "Farm Progress Show", attendees: "~10,000", format: "Displays & Discussions", audience: "General Public" },
  { date: "September 2022", title: "Iowa Soybean Association Field Day", attendees: "~50", format: "Presentations & Stations", audience: "Farmers & Stakeholders" },
  { date: "October 2022", title: "Agronomy Transfer Students", attendees: "~20", format: "Presentations", audience: "Juniors & Seniors, ISU" },
  { date: "November 2022", title: "AGRON 183", attendees: "37", format: "Presentations", audience: "Freshmen, ISU" },
  { date: "November 2022", title: "Women in Ag Group", attendees: "10", format: "Presentations & Stations", audience: "Undergraduate Women, ISU" },
  { date: "March 2023", title: "4H Youth Leaders: Ag Innovation", attendees: "~28", format: "Presentations & Stations", audience: "9th–12th Graders" },
  { date: "April 2023", title: "WiSE Go Further", attendees: "8", format: "Rover Activity", audience: "8th Graders" },
  { date: "May 2023", title: "Fellows Outreach", attendees: "200", format: "Stations", audience: "4th & 5th Graders" },
  { date: "February 2024", title: "4H Youth Leaders: Ag Innovators Experience", attendees: "13", format: "Presentations & Stations", audience: "11th & 12th Graders" },
  { date: "April 2024", title: "Iowa State Science Fair", attendees: "17", format: "Rover Activity", audience: "9th–12th Graders" },
  { date: "August 2024", title: "Farm Progress Show", attendees: "10,500", format: "Stations", audience: "General Public" },
  { date: "October 2024", title: "Global Youth Institute with World Food Prize", attendees: "~200", format: "Presentations & Activities", audience: "11th & 12th Graders" },
  { date: "March 2025", title: "Iowa State Science Fair", attendees: "~40", format: "Rover Activity", audience: "9th–12th Graders" },
  { date: "April 2025", title: "Nutrien Ag Careers Campus Immersion Experience", attendees: "~20–30", format: "Presentations", audience: "9th–12th Graders" },
  { date: "August 2025", title: "AGRON 2790", attendees: "~50–60", format: "Breeding Games", audience: "Sophomores & Juniors, ISU" },
  { date: "November 2025", title: "WiSE Go Further", attendees: "16", format: "Weed ID Activity", audience: "7th–10th Graders" },
  { date: "March 2026", title: "Iowa State Science Fair", attendees: "69", format: "Drones, AI & Modern Agriculture Stations", audience: "6th–12th Graders" },
  { date: "April 2026", title: "WiSE Go Further", attendees: "34", format: "Drones, AI & Modern Agriculture", audience: "7th–10th Graders" },
  { date: "May 2026", title: "CropQuest Challenge with Bayer Crop Science", attendees: "25 (5 teams of 5)", format: "Ag + AI Solution Innovator Challenge", audience: "High School FFA Students" },
  { date: "June 2026", title: "4H Youth Camp", attendees: "17", format: "Drones & AI in Modern Agriculture", audience: "High School 4H Students" },
  { date: "July 2026", title: "Agron 5940: Agronomy MS Practicum", attendees: "8", format: "AI in Agriculture & Drone Processing Pipeline", audience: "Online MS Agronomy Students" }
];
---

<BaseLayout title="Outreach">
  <div class="outreach-hero">
    <div class="container">
      <span class="hero-eyebrow">WIAA Outreach</span>
      <h1>Growing the Next Generation of Ag Innovators</h1>
      <p>From the field to the classroom, five years of connecting students with real-world agricultural and technology education.</p>

      <div class="hero-stats">
        {stats.map(stat => (
          <div class="hero-stat">
            <span class="hero-stat-number">{stat.number}</span>
            <span class="hero-stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="container page-content">

    <!-- Tools Section -->
    <section class="tools-section">
      <span class="section-eyebrow">In the Field</span>
      <h2>The Tools We Bring</h2>
      <p class="section-intro">Every event is hands-on. These are the tools that put real ag-tech directly into students' hands.</p>

      <div class="tools-grid">
        {tools.map(tool => (
          <div class="tool-card">
            <div class="tool-image">
              <img src={tool.image} alt={tool.name} />
            </div>
            <div class="tool-body">
              <h3>{tool.name}</h3>
              <p>{tool.tagline}</p>
              <div class="tool-action-photos">
                {tool.actionPhotos.map(photo => (
                  <img src={photo} alt={`Students using ${tool.name}`} class="tool-action-photo" />
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Gallery Section -->
    <section class="gallery-section">
      <span class="section-eyebrow">Moments From the Field</span>
      <h2>Five Years, One Field at a Time</h2>
      <p class="section-intro">A look back at the students, farms, fairs, and classrooms WIAA has reached since 2022.</p>

      <div class="photo-mosaic">
        {galleryPhotos.map(photo => (
          <div class={`mosaic-item ${photo.size === 'large' ? 'mosaic-large' : ''}`}>
            <img src={photo.src} alt={photo.title} loading="lazy" />
            <div class="mosaic-caption">
              <span class="mosaic-title">{photo.title}</span>
              <span class="mosaic-date">{photo.date}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Timeline Section -->
    <section class="timeline-section">
      <span class="section-eyebrow">The Full Record</span>
      <h2>Every Event, Every Season</h2>
      <p class="section-intro">Every stop on the journey so far &mdash; from a single classroom visit to a 10,000-person field show.</p>

      <div class="timeline">
        {timelineEvents.map(event => (
          <div class="timeline-item">
            <div class="timeline-marker">
              <i class="fas fa-seedling"></i>
            </div>
            <div class="timeline-content">
              <span class="timeline-date">{event.date}</span>
              <h3>{event.title}</h3>
              <span class="timeline-format">{event.format}</span>
              <div class="timeline-meta">
                <div class="meta-item">
                  <i class="fas fa-users"></i>
                  <span><strong>{event.attendees}</strong> attendees</span>
                </div>
                <div class="meta-item">
                  <i class="fas fa-user-group"></i>
                  <span>{event.audience}</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA Section -->
    <div class="cta-box">
      <h3>Get Involved</h3>
      <p>Interested in bringing WIAA programming to your school or organization?</p>
      <a href="/WIAA/contact" class="btn btn-primary">Contact Us</a>
    </div>
  </div>
</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────── */
  .outreach-hero {
    background: var(--isu-red);
    color: white;
    padding: 90px 40px 60px;
    text-align: center;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 18px;
  }

  .outreach-hero h1 {
    font-size: 54px;
    font-weight: 400;
    margin-bottom: 18px;
    color: white;
    line-height: 1.15;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
    max-width: 850px;
    margin-left: auto;
    margin-right: auto;
  }

  .outreach-hero p {
    font-size: 18px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.9);
    font-family: Georgia, Garamond, 'Times New Roman', serif;
    font-weight: 400;
    max-width: 640px;
    margin: 0 auto;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
    margin-top: 55px;
    padding-top: 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 35px;
    border-right: 1px solid rgba(255, 255, 255, 0.25);
    flex: 1;
    min-width: 150px;
  }

  .hero-stat:last-child {
    border-right: none;
  }

  .hero-stat-number {
    font-size: 30px;
    font-weight: 400;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
    color: white;
    line-height: 1.2;
  }

  .hero-stat-label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.75);
    margin-top: 8px;
    text-align: center;
  }

  .page-content {
    padding: 90px 40px;
  }

  .section-eyebrow {
    display: block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--isu-red);
    margin-bottom: 12px;
  }

  section h2 {
    color: var(--text-dark);
    font-size: 40px;
    font-weight: 400;
    line-height: 1.2;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
    margin-bottom: 16px;
  }

  .section-intro {
    color: var(--text-medium);
    font-size: 17px;
    line-height: 1.7;
    max-width: 640px;
    margin-bottom: 45px;
  }

  /* ── Tools Section ────────────────────────────── */
  .tools-section {
    margin-bottom: 100px;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
  }

  .tool-card {
    background: white;
    border: 1px solid var(--border-light);
    overflow: hidden;
  }

  .tool-image {
    width: 100%;
    height: 260px;
    overflow: hidden;
  }

  .tool-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tool-body {
    padding: 30px;
  }

  .tool-body h3 {
    font-size: 26px;
    font-weight: 400;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
    color: var(--text-dark);
    margin: 0 0 10px 0;
  }

  .tool-body p {
    color: var(--text-medium);
    font-size: 15px;
    line-height: 1.7;
    margin: 0 0 20px 0;
  }

  .tool-action-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .tool-action-photo {
    width: 100%;
    height: 130px;
    object-fit: cover;
    display: block;
    border: 1px solid var(--border-light);
  }

  /* ── Gallery / Mosaic ─────────────────────────── */
  .gallery-section {
    margin-bottom: 100px;
  }

  .photo-mosaic {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    grid-auto-rows: 190px;
    grid-auto-flow: dense;
    gap: 12px;
  }

  .mosaic-item {
    position: relative;
    overflow: hidden;
    background: var(--border-light);
  }

  .mosaic-large {
    grid-column: span 2;
    grid-row: span 2;
  }

  .mosaic-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .mosaic-item:hover img {
    transform: scale(1.05);
  }

  .mosaic-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 30px 14px 12px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0));
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mosaic-title {
    color: white;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
  }

  .mosaic-date {
    color: rgba(255, 255, 255, 0.8);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* ── Timeline ─────────────────────────────────── */
  .timeline-section {
    margin-bottom: 60px;
  }

  .timeline {
    position: relative;
    max-width: 760px;
    padding-left: 10px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 23px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: var(--border-light);
  }

  .timeline-item {
    position: relative;
    display: flex;
    gap: 26px;
    padding-bottom: 42px;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-marker {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: white;
    border: 2px solid var(--isu-red);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--isu-red);
    font-size: 16px;
  }

  .timeline-content {
    padding-top: 4px;
  }

  .timeline-date {
    display: block;
    color: var(--text-light);
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 6px;
  }

  .timeline-content h3 {
    color: var(--text-dark);
    font-size: 22px;
    font-weight: 400;
    line-height: 1.3;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
    margin: 0 0 6px 0;
  }

  .timeline-format {
    display: inline-block;
    color: var(--isu-red);
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .timeline-meta {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-medium);
    font-size: 14px;
  }

  .meta-item i {
    color: var(--isu-red);
    font-size: 14px;
  }

  .meta-item strong {
    color: var(--isu-red);
    font-weight: 600;
  }

  /* ── CTA Box ──────────────────────────────────── */
  .cta-box {
    background: white;
    padding: 40px;
    border: 1px solid var(--border-light);
    text-align: center;
    margin-top: 80px;
  }

  .cta-box h3 {
    color: var(--text-dark);
    margin-bottom: 15px;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.3;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }

  .cta-box p {
    margin-bottom: 30px;
    color: var(--text-medium);
    font-size: 16px;
    line-height: 1.7;
  }

  /* ── Mobile responsiveness ────────────────────── */
  @media (max-width: 767px) {
    .outreach-hero {
      padding: 60px 25px 40px;
    }

    .outreach-hero h1 {
      font-size: 34px;
      margin-bottom: 15px;
    }

    .outreach-hero p {
      font-size: 16px;
    }

    .hero-stats {
      margin-top: 35px;
      padding-top: 30px;
    }

    .hero-stat {
      flex: 1 1 45%;
      padding: 15px;
      border-right: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    }

    .hero-stat-number {
      font-size: 24px;
    }

    .page-content {
      padding: 60px 25px;
    }

    section h2 {
      font-size: 30px;
    }

    .tools-grid {
      grid-template-columns: 1fr;
    }

    .photo-mosaic {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      grid-auto-rows: 150px;
    }

    .mosaic-large {
      grid-column: span 2;
