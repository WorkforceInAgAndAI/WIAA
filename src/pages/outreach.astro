  { src: "/WIAA/images/outreach/2026_GoFurther_Fall_3.jpg", title: "WiSE Go Further", date: "April 2026" },
  { src: "/WIAA/images/outreach/2026_SSTFI_1.jpg", title: "Iowa State Science Fair", date: "March 2026", size: "large" },
  { src: "/WIAA/images/outreach/2026_SSTFI_2.jpg", title: "Iowa State Science Fair", date: "March 2026" },
  { src: "/WIAA/images/outreach/2026_SSTFI_3.jpg", title: "Iowa State Science Fair", date: "March 2026" },
  { src: "/WIAA/images/outreach/2026_SSTFI_4.jpg", title: "Iowa State Science Fair", date: "March 2026" },
  { src: "/WIAA/images/outreach/2026_SSTFI_5.jpg", title: "Iowa State Science Fair", date: "March 2026" }
