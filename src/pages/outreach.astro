  { src: "/WIAA/images/outreach/2023_WiseGoFurther_1.jpg", title: "WiSE Go Further", date: "April 2023" },
  { src: "/WIAA/images/outreach/2023_WISEGoFurther_2.jpg", title: "WiSE Go Further", date: "April 2023" },
  { src: "/WIAA/images/outreach/2023_WISEGoFurther_3.jpg", title: "WiSE Go Further", date: "April 2023" },
  { src: "/WIAA/images/outreach/2024_4HYouthLeaders_1.jpg", title: "4H Youth Leaders: Ag Innovators Experience", date: "February 2024" },
  { src: "/WIAA/images/outreach/2024_4HYouthLeaders_2.jpg", title: "4H Youth Leaders: Ag Innovators Experience", date: "February 2024" },
  { src: "/WIAA/images/outreach/2024_4HYouthLeaders_3.jpg", title: "4H Youth Leaders: Ag Innovators Experience", date: "February 2024" },
  { src: "/WIAA/images/outreach/2024_4HYouthLeaders_4.jpg", title: "4H Youth Leaders: Ag Innovators Experience", date: "February 2024" },
  { src: "/WIAA/images/outreach/2024_FPS_1.JPG", title: "Farm Progress Show", date: "August 2024", size: "large" },
  { src: "/WIAA/images/outreach/2024_FPS_2.JPG", title: "Farm Progress Show", date: "August 2024" },
  { src: "/WIAA/images/outreach/2024_FPS_3.jpg", title: "Farm Progress Show", date: "August 2024" },
  { src: "/WIAA/images/outreach/2024_FPS_4.JPG", title: "Farm Progress Show", date: "August 2024" },
