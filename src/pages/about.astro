---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About">
  <div class="container page-content">
    <div class="content-box">
      <h1>About WIAA</h1>
      
      <p class="intro">The Workforce in Agriculture and Artificial Intelligence (WIAA) unites researchers in agriculture, computer science, and engineering to create impactful learning opportunities for K-16 students and stakeholders on the use of emerging technologies in agriculture.</p>
      <p>WIAA has reached over 1,000 K-16 students and over 20,600 stakeholders and members of the public, preparing an AI-ready workforce.</p>
     
      <h2>Our Team</h2>
      <p>WIAA consists of students with backgrounds in agronomy and engineering who work together to create applicable and impactful learning experiences.</p>
     
      <div class="cta-section">
        <a href="/WIAA/contact" class="btn btn-primary">Get in Touch</a>
        <a href="/WIAA/outreach" class="btn btn-secondary" style="margin-left: 15px;">View Our Programs</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-content {
    padding: 80px 40px;
  }

  .content-box {
    background: white;
    padding: 60px;
    max-width: 900px;
    margin: 0 auto;
    border-bottom: 1px solid var(--border-light);
  }

  .content-box h1 {
    margin-bottom: 30px;
    border-bottom: 1px solid var(--border-light);
    padding-bottom: 20px;
    font-size: 54px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--text-dark);
  }

  .intro {
    font-size: 16px;
    color: var(--text-medium);
    line-height: 1.7;
    margin-bottom: 20px;
    font-weight: 400;
  }

  .content-box h2 {
    color: var(--text-dark);
    margin: 40px 0 20px;
    font-size: 42px;
    font-weight: 400;
    line-height: 1.2;
  }

  .content-box h3 {
    color: var(--text-dark);
    margin: 25px 0 15px;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.3;
  }

  .content-box p {
    line-height: 1.7;
    margin-bottom: 20px;
    font-size: 16px;
    color: var(--text-medium);
  }

  .content-box ul {
    margin: 15px 0 20px 20px;
    line-height: 1.8;
  }

  .content-box li {
    margin-bottom: 15px;
    color: var(--text-medium);
  }

  .cta-section {
    text-align: center;
    margin-top: 50px;
    padding-top: 30px;
    border-top: 1px solid var(--border-light);
  }

  /* Mobile responsiveness */
  @media (max-width: 767px) {
    .page-content {
      padding: 60px 25px;
    }

    .content-box {
      padding: 40px 25px;
    }

    .content-box h1 {
      font-size: 36px;
      margin-bottom: 20px;
      padding-bottom: 15px;
    }

    .content-box h2 {
      font-size: 32px;
      margin: 30px 0 15px;
    }

    .content-box h3 {
      font-size: 24px;
    }
  }
</style>