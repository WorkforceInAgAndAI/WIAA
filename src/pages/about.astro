---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About">
  <div class="container page-content">
    <div class="content-box">
      <h1>About WIAA</h1>
      
      <p class="intro">The Workforce in Agriculture and Artificial Intelligence (WIAA) unites researchers in agriculture, computer science, and engineering to create impactful learning opportunities for K-16 students and stakeholders on the use of emerging technologies in agriculture.</p>

<p> WIAA has reached over 1,000 K-16 students and over 20,600 stakeholders and members of the public, preparing an AI-ready workforce. <p>

     

      <h2>Our Team</h2>
      <p>WIAA consists of students with backgrounds in agronomy and engineering who work together to create applicable and impactful learning experiences.</p>
     
      <div class="cta-section">
        <a href="/WIAA/contact" class="btn btn-primary">Get in Touch</a>
        <a href="/WIAA/outreach" class="btn btn-secondary" style="margin-left: 15px;">View Our Programs</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-content {
    padding: 60px 20px;
  }

  .content-box {
    background: white;
    padding: 40px;
    border-radius: 8px;
    border: 1px solid var(--border-light);
    max-width: 900px;
    margin: 0 auto;
  }

  .content-box h1 {
    margin-bottom: 20px;
    border-bottom: 2px solid var(--isu-gold);
    padding-bottom: 15px;
  }

  .intro {
    font-size: 1.1em;
    color: var(--text-medium);
    line-height: 1.8;
    margin-bottom: 30px;
    font-weight: 500;
  }

  .content-box h2 {
    color: var(--isu-red);
    margin: 40px 0 20px;
    font-size: 1.6em;
  }

  .content-box h3 {
    color: var(--isu-red);
    margin: 25px 0 15px;
    font-size: 1.2em;
  }

  .content-box p {
    line-height: 1.7;
    margin-bottom: 15px;
  }

  .content-box ul {
    margin: 15px 0 20px 20px;
    line-height: 1.8;
  }

  .content-box li {
    margin-bottom: 10px;
  }

  .cta-section {
    text-align: center;
    margin-top: 50px;
    padding-top: 30px;
    border-top: 2px solid var(--border-light);
  }
</style>