---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Rover Program">
  <div class="container page-content">
    <div class="content-box">
      <h1>Rover Program - Coming Soon</h1>
     
      <div class="cta-section">
        <a href="/WIAA/contact" class="btn btn-primary">Contact Us for Updates</a>
        <a href="/WIAA/drones" class="btn btn-secondary" style="margin-left: 15px;">Explore Drone Program</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-content {
    padding: 80px 40px;
  }

  .content-box {
    background: white;
    padding: 60px;
    max-width: 900px;
    margin: 0 auto;
    border-bottom: 1px solid var(--border-light);
  }

  .content-box h1 {
    margin-bottom: 30px;
    border-bottom: 1px solid var(--border-light);
    padding-bottom: 20px;
    font-size: 54px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--text-dark);
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }

  .coming-soon-banner {
    background: white;
    padding: 40px;
    text-align: center;
    margin: 30px 0;
    border: 1px solid var(--border-light);
  }

  .coming-soon-banner h2 {
    color: var(--text-dark);
    margin-bottom: 15px;
    font-size: 42px;
    font-weight: 400;
    line-height: 1.2;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }

  .content-box h3 {
    color: var(--text-dark);
    margin: 30px 0 15px;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.3;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }

  .content-box ul {
    margin: 15px 0 20px 20px;
    line-height: 1.8;
  }

  .content-box li {
    margin-bottom: 15px;
    font-size: 16px;
    color: var(--text-medium);
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }

  .cta-section {
    text-align: center;
    margin-top: 50px;
    padding-top: 30px;
    border-top: 1px solid var(--border-light);
  }

  /* Mobile responsiveness */
  @media (max-width: 767px) {
    .page-content {
      padding: 60px 25px;
    }

    .content-box {
      padding: 40px 25px;
    }

    .content-box h1 {
      font-size: 36px;
      margin-bottom: 20px;
      padding-bottom: 15px;
    }

    .coming-soon-banner h2 {
      font-size: 32px;
      margin-bottom: 15px;
    }

    .content-box h3 {
      font-size: 24px;
      margin: 25px 0 12px;
    }

    .content-box li {
      margin-bottom: 12px;
    }
  }
</style>