---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sidebar from '../../../components/Sidebar.astro';
import LessonNav from '../../../components/LessonNav.astro';
import LegalOrIllegalSort from '../../../components/LegalOrIllegalSort.astro';
import Quiz from '../../../components/Quiz.astro';
import pilotExamRaw from '../../../../public/data/quizzes/pilot-exam.json?raw';

const content = await import('../../../content/drones/04-faa-safety/lesson-4.md');
const { Content } = content;
const { title, chapter, lesson } = content.frontmatter;
const pilotExamData = JSON.parse(pilotExamRaw);
---

<BaseLayout title={title}>
  <div class="container" style="max-width: 1400px; margin: 30px auto; padding: 0 20px;">
    <div style="display: grid; grid-template-columns: 250px 1fr; gap: 24px; align-items: start;">
      <Sidebar currentChapter={chapter} currentLesson={lesson} />
      <div class="content-area">
        <div class="content-header">
          <p class="chapter-label">Chapter {chapter}: FAA Part 107 & Drone Safety</p>
          <h1>{title}</h1>
        </div>
        <article class="lesson-content">
          <Content />
        </article>
        <LegalOrIllegalSort />
        <Quiz questions={pilotExamData} />
        <LessonNav 
          prev={{ href: '/drones/04-faa-safety/lesson-3', label: 'Previous' }}
          next={{ href: '/drones/04-faa-safety/lesson-5', label: 'Next' }}
          progress={`${chapter}.${lesson} / 12 Chapters`}
        />
      </div>
    </div>
  </div>
</BaseLayout>
<style is:global>
  :root {
    --isu-red: #c41e3a;
    --isu-gold: #f8c600;
    --isu-dark-red: #a01729;
    --text-primary: #1a1a1a;
    --text-secondary: #666666;
    --border-color: #e5e7eb;
  }

  .lesson-content img {
    max-width: 800px !important;
    height: auto !important;
    display: block !important;
    margin: 30px auto !important;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    border: 1px solid var(--border-color);
  }
  @media (max-width: 767px) {
    .lesson-content img {
      max-width: 100% !important;
    }
  }

  .section-intro {
    font-size: 1.1em;
    line-height: 1.8;
    color: var(--text-secondary);
    background: linear-gradient(135deg, rgba(196, 30, 58, 0.04), rgba(248, 198, 0, 0.04));
    padding: 24px;
    border-left: 4px solid var(--isu-red);
    border-radius: 8px;
    margin: 0 0 32px 0;
  }
  .section-intro a {
    color: var(--isu-red);
    font-weight: 600;
  }

  .lesson-content h2 {
    font-size: 1.8em;
    font-weight: 700;
    color: var(--isu-red);
    margin: 45px 0 28px 0;
    letter-spacing: -0.5px;
  }

  /* Rules timeline */
  .rules-timeline { margin: 40px 0 20px 0; position: relative; }
  .rules-timeline::before {
    content: '';
    position: absolute;
    left: 35px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, var(--isu-red) 0%, var(--isu-gold) 100%);
  }
  .rule-item {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 32px;
    align-items: flex-start;
    margin-bottom: 28px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
    width: 100%;
    transition: all 0.3s ease;
  }
  .rule-item:hover { transform: translateX(8px); }
  .rule-marker { position: relative; display: flex; justify-content: center; }
  .rule-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 70px;
    height: 70px;
    background: linear-gradient(135deg, #c41e3a, #a01729);
    color: white;
    font-size: 1.8em;
    font-weight: 700;
    border-radius: 50%;
    z-index: 2;
    box-shadow: 0 4px 12px rgba(196, 30, 58, 0.3);
  }
  .rule-content {
    padding: 24px 28px;
    background: white;
    border-left: 4px solid var(--isu-red);
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }
  .rule-content h3 {
    font-size: 1.25em;
    font-weight: 700;
    color: var(--isu-red);
    margin: 0 0 12px 0;
  }
  .rule-description { margin: 0; font-size: 1.05em; line-height: 1.6; color: var(--text-primary); }
  .rule-details ul { list-style: none; padding: 0; margin: 0; }
  .rule-details li {
    font-size: 1.05em;
    line-height: 1.6;
    color: var(--text-primary);
    margin: 10px 0;
    padding-left: 24px;
    position: relative;
  }
  .rule-details li::before {
    content: '•';
    position: absolute;
    left: 4px;
    color: var(--isu-red);
    font-weight: bold;
    font-size: 1.3em;
  }
  @media (max-width: 768px) {
    .rules-timeline::before { left: 24px; }
    .rule-item { grid-template-columns: 60px 1fr; gap: 20px; }
    .rule-num { width: 60px; height: 60px; font-size: 1.4em; }
  }

  /* Activities list */
  .activities-list { list-style: none; padding: 0; margin: 24px 0; }
  .activities-list li {
    font-size: 1.05em;
    line-height: 1.8;
    color: var(--text-primary);
    margin: 14px 0;
    padding-left: 24px;
    position: relative;
  }
  .activities-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--isu-red);
    font-weight: bold;
    font-size: 1.2em;
  }
</style>
<style>
  @media (max-width: 768px) {
    div[style*="grid-template-columns"] {
      display: flex !important;
      flex-direction: column-reverse !important;
      gap: 16px !important;
    }
  }
</style>