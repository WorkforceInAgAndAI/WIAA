---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sidebar from '../../../components/Sidebar.astro';
import LessonNav from '../../../components/LessonNav.astro';
import Quiz from '../../../components/Quiz.astro';
import quizRaw from '../../../../public/data/quizzes/04-faa-safety.json?raw';
const quizData = JSON.parse(quizRaw);
const chapter = 4;
const lesson = 7;
---

<BaseLayout title="Concept Review">
  <div class="container" style="max-width: 1400px; margin: 30px auto; padding: 0 20px;">
    <div style="display: grid; grid-template-columns: 250px 1fr; gap: 24px; align-items: start;">
      <Sidebar currentChapter={chapter} currentLesson={lesson} />
      <div class="content-area">
        <div class="content-header">
          <p class="chapter-label">Chapter {chapter}: FAA Part 107 & Drone Safety</p>
          <h1>Concept Review</h1>
        </div>
        <p>Test your understanding with the quiz below:</p>
        <Quiz questions={quizData} />

        <div class="exam-callout">
          <h4>Part 107 Honorary Pilot's Exam</h4>
          <p>Ready to go further? Complete the WIAA: Part 107 Small Unmanned Aerial System Honorary Pilot Exam. You need a score of 70% or higher to pass.</p>
        </div>

        <LessonNav 
          prev={{ href: '/drones/04-faa-safety/lesson-6', label: 'Previous' }}
          next={{ href: '/drones/05-planning-positioning/lesson-1', label: 'Next' }}
          progress={`${chapter}.${lesson} / 12 Chapters`}
        />
      </div>
    </div>
  </div>
</BaseLayout>
<style is:global>
  .lesson-content img {
    max-width: 800px !important;
    height: auto !important;
    display: block !important;
    margin: 20px auto !important;
  }
  @media (max-width: 767px) {
    .lesson-content img {
      max-width: 280px !important;
    }
  }
  .exam-callout {
    background: linear-gradient(135deg, rgba(196, 30, 58, 0.08) 0%, rgba(255, 184, 28, 0.08) 100%);
    border-left: 5px solid var(--isu-gold, #f8c600);
    border-radius: 6px;
    padding: 24px;
    margin: 30px 0;
  }
  .exam-callout h4 {
    margin: 0 0 10px;
    color: var(--isu-red, #c41e3a);
  }
  .exam-callout p {
    margin: 0;
    line-height: 1.7;
    color: var(--text-primary, #1a1a1a);
  }
</style>
<style>
  @media (max-width: 768px) {
    div[style*="grid-template-columns"] {
      display: flex !important;
      flex-direction: column-reverse !important;
      gap: 16px !important;
    }
  }
</style>