---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sidebar from '../../../components/Sidebar.astro';
import LessonNav from '../../../components/LessonNav.astro';
import FutureRoleReflection from '../../../components/FutureRoleReflection.astro';

const content = await import('../../../content/drones/12-careers/lesson-3.md');
const { Content } = content;
const { title, chapter, lesson } = content.frontmatter;
---

<BaseLayout title={title}>
  <div class="container" style="max-width: 1400px; margin: 30px auto; padding: 0 20px;">
    <div style="display: grid; grid-template-columns: 250px 1fr; gap: 24px; align-items: start;">
      <Sidebar currentChapter={chapter} currentLesson={lesson} />
      <div class="content-area">
        <div class="content-header">
          <p class="chapter-label">Chapter {chapter}: Careers</p>
          <h1>{title}</h1>
        </div>
        <article class="lesson-content">
          <Content />
        </article>
        <FutureRoleReflection />
        <LessonNav 
          prev={{ href: '/drones/12-careers/lesson-2', label: 'Previous' }}
          next={{ href: '/drones/12-careers/review', label: 'Next' }}
          progress={`${chapter}.${lesson} / 12 Chapters`}
        />
      </div>
    </div>
  </div>
</BaseLayout>
<style is:global>
  :root {
    --isu-red: #c41e3a;
    --isu-gold: #f8c600;
    --isu-dark-red: #a01729;
    --text-primary: #1a1a1a;
    --text-secondary: #666666;
    --border-color: #e5e7eb;
  }
.career-paths-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
  margin: 28px 0;
}
@media (min-width: 700px) {
  .career-paths-grid {
    grid-template-columns: 1fr 1fr;
  }
}
.career-path-card {
  background: white;
  border: 1px solid var(--border-color, #e5e7eb);
  border-radius: 10px;
  padding: 18px 20px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}
.career-path-card:hover {
  box-shadow: 0 6px 18px rgba(196, 30, 58, 0.12);
  border-color: var(--isu-red, #c41e3a);
}
.career-path-card h4 {
  margin: 0 0 6px 0;
  color: var(--isu-red, #c41e3a);
  font-size: 1.05em;
}
.career-path-card p {
  margin: 0;
  color: var(--text-secondary, #666);
  font-size: 0.92em;
  line-height: 1.5;
}

  .lesson-content img {
    max-width: 900px !important;
    height: auto !important;
    display: block !important;
    margin: 40px auto !important;
    border-radius: 12px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.12);
    border: 1px solid var(--border-color);
  }
  @media (max-width: 767px) {
    .lesson-content img {
      max-width: 100% !important;
    }
  }

  .lesson-intro {
    background: linear-gradient(135deg, #f5f5f5 0%, #ffffff 100%);
    padding: 24px;
    border-left: 4px solid var(--isu-red);
    border-radius: 4px;
    margin-bottom: 30px;
    font-size: 1.1em;
    line-height: 1.8;
    color: var(--text-primary);
  }

  .lesson-content h2 {
    font-size: 1.8em;
    font-weight: 700;
    color: var(--isu-red);
    margin: 45px 0 28px 0;
    letter-spacing: -0.5px;
  }

  .impact-callout {
    background: linear-gradient(135deg, rgba(196, 30, 58, 0.08) 0%, rgba(255, 184, 28, 0.08) 100%);
    border-left: 5px solid var(--isu-red);
    border-radius: 6px;
    padding: 24px;
    margin: 28px 0;
  }
  .impact-callout h4 {
    color: var(--isu-red);
    margin-top: 0;
    margin-bottom: 12px;
    font-size: 1.15em;
  }
  .impact-callout p {
    color: var(--text-primary);
    line-height: 1.7;
    margin: 0;
  }

  /* Pathways grid */
  .pathways-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin: 32px 0 40px 0;
  }
  @media (min-width: 900px) {
    .pathways-grid { grid-template-columns: 1fr 1fr; gap: 28px; }
  }
  .pathway-card {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }
  .pathway-header { padding: 24px; color: white; }
  .pathway-header h3 { margin: 0; font-size: 1.4em; color: white; }
  .agriculture-header { background: linear-gradient(135deg, #2d5016, #3d6b1f); }
  .engineering-header { background: linear-gradient(135deg, #c41e3a, #a01729); }
  .pathway-image {
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    height: 160px !important;
    object-fit: cover;
    margin: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    border: none !important;
  }
  .pathway-content { padding: 24px; background: white; }
  .pathway-content ul { list-style: none; padding: 0; margin: 0; }
  .pathway-content li {
    font-size: 1.05em;
    line-height: 1.8;
    color: var(--text-primary);
    margin: 10px 0;
    padding-left: 26px;
    position: relative;
  }
  .agriculture .pathway-content li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: #2d5016;
    font-weight: bold;
    font-size: 1.2em;
  }
  .engineering .pathway-content li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--isu-red);
    font-weight: bold;
    font-size: 1.2em;
  }

  .activities-list { list-style: none; padding: 0; margin: 24px 0; }
  .activities-list li {
    font-size: 1.05em;
    line-height: 1.8;
    color: var(--text-primary);
    margin: 14px 0;
    padding-left: 24px;
    position: relative;
  }
  .activities-list li::before {
    content: '\2192';
    position: absolute;
    left: 0;
    color: var(--isu-red);
    font-weight: bold;
    font-size: 1.2em;
  }
  .activities-list a { color: var(--isu-red); text-decoration: none; font-weight: 600; }
  .activities-list a:hover { text-decoration: underline; }
</style>
<style>
  @media (max-width: 768px) {
    div[style*="grid-template-columns"] {
      display: flex !important;
      flex-direction: column-reverse !important;
      gap: 16px !important;
    }
  }
</style>