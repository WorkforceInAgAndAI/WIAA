---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sidebar from '../../../components/Sidebar.astro';
import LessonNav from '../../../components/LessonNav.astro';
import AIWeedMatchGame from '../../../components/AIWeedMatchGame.astro';
import AIActivityReveal from '../../../components/AIActivityReveal.astro';

const content = await import('../../../content/drones/08-ai-agriculture/lesson-4.md');
const { Content } = content;
const { title, chapter, lesson } = content.frontmatter;
---

<BaseLayout title={title}>
  <div class="container" style="max-width: 1400px; margin: 30px auto; padding: 0 20px;">
    <div style="display: grid; grid-template-columns: 250px 1fr; gap: 24px; align-items: start;">
      <Sidebar currentChapter={chapter} currentLesson={lesson} />
      <div class="content-area">
        <div class="content-header">
          <p class="chapter-label">Chapter {chapter}: AI in Agriculture</p>
          <h1>{title}</h1>
        </div>
        <article class="lesson-content">
          <Content />
        </article>
        <AIActivityReveal />
        <AIWeedMatchGame />
        <LessonNav 
          prev={{ href: '/drones/08-ai-agriculture/lesson-3', label: 'Previous' }}
          next={{ href: '/drones/08-ai-agriculture/review', label: 'Next' }}
          progress={`${chapter}.${lesson} / 12 Chapters`}
        />
      </div>
    </div>
  </div>
</BaseLayout>
<style is:global>
  :root {
    --isu-red: #c41e3a;
    --isu-gold: #f8c600;
    --isu-dark-red: #a01729;
    --text-primary: #1a1a1a;
    --text-secondary: #666666;
    --border-color: #e5e7eb;
  }

  .lesson-content img {
    max-width: 900px !important;
    height: auto !important;
    display: block !important;
    margin: 40px auto !important;
    border-radius: 12px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.12);
    border: 1px solid var(--border-color);
  }
  @media (max-width: 767px) {
    .lesson-content img {
      max-width: 100% !important;
    }
  }

  .lesson-intro {
    background: linear-gradient(135deg, #f5f5f5 0%, #ffffff 100%);
    padding: 24px;
    border-left: 4px solid var(--isu-red);
    border-radius: 4px;
    margin-bottom: 30px;
    font-size: 1.1em;
    line-height: 1.8;
    color: var(--text-primary);
  }

  .section-intro {
    font-size: 1.1em;
    line-height: 1.8;
    color: var(--text-secondary);
    background: linear-gradient(135deg, rgba(196, 30, 58, 0.04), rgba(248, 198, 0, 0.04));
    padding: 24px;
    border-left: 4px solid var(--isu-red);
    border-radius: 8px;
    margin: 0 0 32px 0;
  }

  .lesson-content h2 {
    font-size: 1.8em;
    font-weight: 700;
    color: var(--isu-red);
    margin: 45px 0 28px 0;
    letter-spacing: -0.5px;
  }

  /* Process steps */
  .process-steps {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 32px 0 30px 0;
  }
  .process-step {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 20px;
    align-items: start;
    background: white;
    border: 1.5px solid var(--border-color);
    border-radius: 12px;
    padding: 24px;
  }
  .step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, #c41e3a, #a01729);
    color: white;
    font-size: 1.8em;
    font-weight: 700;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .step-content h3 {
    font-size: 1.2em;
    font-weight: 700;
    color: var(--isu-red);
    margin: 0 0 8px 0;
  }
  .step-content p {
    margin: 0;
    font-size: 1.05em;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .cycle-note {
    background: linear-gradient(135deg, rgba(196, 30, 58, 0.04), rgba(248, 198, 0, 0.04));
    padding: 24px;
    border-left: 4px solid var(--isu-red);
    border-radius: 8px;
    margin: 32px 0 !important;
  }

  .human-loop-content {
    background: white;
    border: 2px solid var(--isu-red);
    padding: 28px;
    border-radius: 10px;
    margin: 28px 0 !important;
    font-size: 1.08em;
    line-height: 1.8;
  }
</style>
<style>
  @media (max-width: 768px) {
    div[style*="grid-template-columns"] {
      display: flex !important;
      flex-direction: column-reverse !important;
      gap: 16px !important;
    }
  }
</style>