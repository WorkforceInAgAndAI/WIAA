---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Drone Program">
<div class="container page-content">
    <div class="content-box">
      <h1>Drone Program</h1>
    </div>

    <div class="objectives-standards">
      <div class="objectives-row">
        <div class="objectives-col">
          <h3>Learning Objectives</h3>
          <ol>
            <li>Understand UAV and UAS components and their functions</li>
            <li>Identify agricultural applications and limitations of drone technology</li>
            <li>Analyze sensor types and data collection methods</li>
            <li>Calculate and interpret vegetation health indices</li>
            <li>Apply AI tools to agricultural problems</li>
            <li>Understand FAA Part 107 regulations and flight safety</li>
            <li>Explore career pathways in agricultural technology</li>
          </ol>
        </div>

        <div class="objectives-col">
          <h3>Next Generation Science Standards</h3>
          <ol>
            <li>HS-PS3-1: Energy in a system</li>
            <li>HS-PS4-2: Electromagnetic radiation</li>
            <li>HS-ETS1-1: Engineering design process</li>
            <li>HS-LS2-3: Ecosystem dynamics</li>
            <li>HS-L4-1: Systems and system models</li>
          </ol>
        </div>
      </div>
    </div>

    <div class="module-box">
      <h2>Drone Education Modules</h2>
      <p>This comprehensive curriculum will guide you through drone technology, AI applications in agriculture, and career preparation. Start below to begin!</p>

      <div class="chapter-preview">
        <h3>What You Will Learn:</h3>
        <div class="preview-grid">
          <div class="preview-card">
            <h4>Chapters 1-3</h4>
            <p>Introduction to drones, drone parts and types, and agricultural applications</p>
          </div>
          <div class="preview-card">
            <h4>Chapters 4-5</h4>
            <p>FAA Part 107 and drone safety, plus flight planning and positioning</p>
          </div>
          <div class="preview-card">
            <h4>Chapters 6-7</h4>
            <p>Sensors and their applications, and vegetation indices</p>
          </div>
          <div class="preview-card">
            <h4>Chapter 8</h4>
            <p>Artificial intelligence and machine learning in agriculture</p>
          </div>
          <div class="preview-card">
            <h4>Chapter 9</h4>
            <p>Drone imagery processing pipeline, from flight to plot extraction</p>
          </div>
          <div class="preview-card">
            <h4>Chapters 10-11</h4>
            <p>The Solution Innovator challenge and a hands-on drone mission</p>
          </div>
          <div class="preview-card">
            <h4>Chapter 12</h4>
            <p>Careers in agriculture, AI, and technology</p>
          </div>
        </div>
      </div>

      <div class="cta-section">
        <a href={base + '/drones/00-learning-goals/lesson-1'} class="btn btn-primary btn-large">Start Learning</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>

.page-content {
    padding: 40px 20px;
    transition: margin-left 0.3s ease;
  }

  .content-box {
    background: white;
    padding: 40px;
    border-radius: 8px;
    border: 1px solid var(--border-light);
    max-width: 900px;
    margin: 0 auto 25px;
  }

  .content-box h1 {
    color: var(--isu-red);
    font-size: 2.2em;
    margin-bottom: 15px;
    border-bottom: 2px solid var(--isu-gold);
    padding-bottom: 15px;
  }

  .content-box p {
    color: var(--text-medium);
    font-size: 1.05em;
    margin: 0;
    line-height: 1.6;
  }

  .objectives-standards {
    background: white;
    padding: 25px;
    border-radius: 8px;
    border: 2px solid var(--isu-gold);
    margin-bottom: 25px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .objectives-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }

  .objectives-col h3 {
    color: var(--isu-red);
    margin: 0 0 15px 0;
    font-size: 1.2em;
  }

  .objectives-col ol {
    margin-left: 20px;
    line-height: 1.8;
  }

  .objectives-col li {
    margin-bottom: 8px;
  }

  .module-box {
    background: white;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    padding: 40px;
  }

  .module-box h2 {
    margin-bottom: 15px;
  }

  .module-box > p {
    color: var(--text-medium);
    margin-bottom: 30px;
  }

  .chapter-preview {
    background: #f9f7f4;
    padding: 25px;
    border-radius: 8px;
    margin: 30px 0;
  }

  .chapter-preview h3 {
    margin-bottom: 20px;
  }

  .preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 15px;
  }

  .preview-card {
    background: white;
    padding: 20px;
    border-radius: 6px;
    border-left: 3px solid var(--isu-gold);
  }

  .preview-card h4 {
    color: var(--isu-red);
    margin-bottom: 8px;
  }

  .preview-card p {
    color: var(--text-medium);
    font-size: 0.95em;
    margin: 0;
  }

  .cta-section {
    text-align: center;
    margin-top: 40px;
  }

  .btn-large {
    padding: 16px 40px;
    font-size: 1.1em;
  }

  @media (max-width: 768px) {
    .objectives-row {
      grid-template-columns: 1fr;
    }

    .module-box {
      padding: 20px;
    }
  }
</style>