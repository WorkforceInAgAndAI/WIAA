---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sidebar from '../../../components/Sidebar.astro';
import LessonNav from '../../../components/LessonNav.astro';
import GCPFillInBlank from '../../../components/GCPFillInBlank.astro';

const content = await import('../../../content/drones/05-planning-positioning/lesson-2.md');
const { Content } = content;
const { title, chapter, lesson } = content.frontmatter;
---

<BaseLayout title={title}>
  <div class="container" style="max-width: 1400px; margin: 30px auto; padding: 0 20px;">
    <div style="display: grid; grid-template-columns: 250px 1fr; gap: 24px; align-items: start;">
      <Sidebar currentChapter={chapter} currentLesson={lesson} />
      <div class="content-area">
        <div class="content-header">
          <p class="chapter-label">Chapter {chapter}: Planning and Positioning</p>
          <h1>{title}</h1>
        </div>
        <article class="lesson-content">
          <Content />
        </article>
        <GCPFillInBlank />
        <LessonNav 
          prev={{ href: '/drones/05-planning-positioning/lesson-1', label: 'Previous' }}
          next={{ href: '/drones/05-planning-positioning/lesson-3', label: 'Next' }}
          progress={`${chapter}.${lesson} / 12 Chapters`}
        />
      </div>
    </div>
  </div>
</BaseLayout>
<style is:global>
  :root {
    --isu-red: #c41e3a;
    --isu-gold: #f8c600;
    --isu-dark-red: #a01729;
    --text-primary: #1a1a1a;
    --text-secondary: #666666;
    --border-color: #e5e7eb;
  }

  .lesson-content img {
    max-width: 800px !important;
    height: auto !important;
    display: block !important;
    margin: 30px auto !important;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    border: 1px solid var(--border-color);
  }
  @media (max-width: 767px) {
    .lesson-content img {
      max-width: 100% !important;
    }
  }

  .lesson-intro {
    background: linear-gradient(135deg, #f5f5f5 0%, #ffffff 100%);
    padding: 24px;
    border-left: 4px solid var(--isu-red);
    border-radius: 4px;
    margin-bottom: 30px;
    font-size: 1.1em;
    line-height: 1.8;
    color: var(--text-primary);
  }

  .section-intro {
    font-size: 1.1em;
    line-height: 1.8;
    color: var(--text-secondary);
    background: linear-gradient(135deg, rgba(196, 30, 58, 0.04), rgba(248, 198, 0, 0.04));
    padding: 24px;
    border-left: 4px solid var(--isu-red);
    border-radius: 8px;
    margin: 0 0 32px 0;
  }

  .faa-info {
    background: white;
    border: 2px solid var(--isu-red);
    padding: 28px;
    border-radius: 10px;
    margin: 28px 0;
  }
  .faa-info p {
    font-size: 1.08em;
    line-height: 1.8;
    color: var(--text-primary);
    margin: 0;
  }
  .faa-info strong {
    color: var(--isu-red);
    font-weight: 700;
  }

  .impact-callout {
    background: linear-gradient(135deg, rgba(196, 30, 58, 0.08) 0%, rgba(255, 184, 28, 0.08) 100%);
    border-left: 5px solid var(--isu-red);
    border-radius: 6px;
    padding: 24px;
    margin: 28px 0;
  }
  .impact-callout h4 {
    color: var(--isu-red);
    margin-top: 0;
    margin-bottom: 12px;
    font-size: 1.15em;
  }
  .impact-callout p {
    color: var(--text-primary);
    line-height: 1.7;
    margin: 0;
  }

  .lesson-content h2 {
    font-size: 1.8em;
    font-weight: 700;
    color: var(--isu-red);
    margin: 45px 0 28px 0;
    letter-spacing: -0.5px;
  }
</style>
<style>
  @media (max-width: 768px) {
    div[style*="grid-template-columns"] {
      display: flex !important;
      flex-direction: column-reverse !important;
      gap: 16px !important;
    }
  }
</style>
