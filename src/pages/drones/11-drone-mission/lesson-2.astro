---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sidebar from '../../../components/Sidebar.astro';
import LessonNav from '../../../components/LessonNav.astro';
import WeedScoutingComparison from '../../../components/WeedScoutingComparison.astro';
import ScoutingReflection from '../../../components/ScoutingReflection.astro';

const content = await import('../../../content/drones/11-drone-mission/lesson-2.md');
const { Content } = content;
const { title, chapter, lesson } = content.frontmatter;
---

<BaseLayout title={title}>
  <div class="container" style="max-width: 1400px; margin: 30px auto; padding: 0 20px;">
    <div style="display: grid; grid-template-columns: 250px 1fr; gap: 24px; align-items: start;">
      <Sidebar currentChapter={chapter} currentLesson={lesson} />
      <div class="content-area">
        <div class="content-header">
          <p class="chapter-label">Chapter {chapter}: Drone Mission</p>
          <h1>{title}</h1>
        </div>
        <article class="lesson-content">
          <Content />
        </article>
        <WeedScoutingComparison />
        <ScoutingReflection />
        <LessonNav 
          prev={{ href: '/drones/11-drone-mission/lesson-1', label: 'Previous' }}
          next={{ href: '/drones/11-drone-mission/review', label: 'Next' }}
          progress={`${chapter}.${lesson} / 12 Chapters`}
        />
      </div>
    </div>
  </div>
</BaseLayout>
<style is:global>
  :root {
    --isu-red: #c41e3a;
    --isu-gold: #f8c600;
    --isu-dark-red: #a01729;
    --text-primary: #1a1a1a;
    --text-secondary: #666666;
    --border-color: #e5e7eb;
  }

  .lesson-content img {
    max-width: 900px !important;
    height: auto !important;
    display: block !important;
    margin: 24px auto !important;
    border-radius: 12px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.12);
    border: 1px solid var(--border-color);
  }
  @media (max-width: 767px) {
    .lesson-content img {
      max-width: 100% !important;
    }
  }

  .lesson-intro {
    background: linear-gradient(135deg, #f5f5f5 0%, #ffffff 100%);
    padding: 24px;
    border-left: 4px solid var(--isu-red);
    border-radius: 4px;
    margin-bottom: 30px;
    font-size: 1.1em;
    line-height: 1.8;
    color: var(--text-primary);
  }

  .section-intro {
    font-size: 1.1em;
    line-height: 1.8;
    color: var(--text-secondary);
    background: linear-gradient(135deg, rgba(196, 30, 58, 0.04), rgba(248, 198, 0, 0.04));
    padding: 24px;
    border-left: 4px solid var(--isu-red);
    border-radius: 8px;
    margin: 0 0 32px 0;
  }

  .lesson-content h2 {
    font-size: 1.8em;
    font-weight: 700;
    color: var(--isu-red);
    margin: 45px 0 28px 0;
    letter-spacing: -0.5px;
  }

  .interpretation-list {
    list-style: none;
    padding: 0;
    margin: 20px 0 40px 0;
  }
  .interpretation-list li {
    font-size: 1.05em;
    line-height: 1.8;
    color: var(--text-primary);
    margin: 14px 0;
    padding-left: 24px;
    position: relative;
  }
  .interpretation-list li::before {
    content: '\2192';
    position: absolute;
    left: 0;
    color: var(--isu-red);
    font-weight: bold;
    font-size: 1.2em;
  }

  /* Method cards */
  .method-card {
    background: white;
    border: 2px solid var(--border-color);
    border-radius: 12px;
    padding: 28px;
    margin: 32px 0;
  }
  .method-card--manual { border-top: 4px solid #6b7280; }
  .method-card--drone { border-top: 4px solid var(--isu-red); }
  .method-card__roles {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 20px;
  }
  @media (min-width: 700px) {
    .method-card__roles { grid-template-columns: 1fr 1fr; }
  }
  .method-role {
    background: #fafafa;
    border-radius: 8px;
    padding: 16px 18px;
  }
  .method-role h4 {
    margin: 0 0 8px 0;
    color: var(--isu-red);
  }
  .method-role p {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .method-card__note {
    font-weight: 600;
    color: var(--isu-dark-red);
    background: #fff8e1;
    border: 1px solid var(--isu-gold);
    border-radius: 6px;
    padding: 12px 16px;
    margin: 16px 0;
  }
</style>
<style>
  @media (max-width: 768px) {
    div[style*="grid-template-columns"] {
      display: flex !important;
      flex-direction: column-reverse !important;
      gap: 16px !important;
    }
  }
</style>