---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sidebar from '../../../components/Sidebar.astro';
import LessonNav from '../../../components/LessonNav.astro';
import TaskShuffle from '../../../components/TaskShuffle.astro';

const content = await import('../../../content/drones/03-agricultural-applications/lesson-1.md');
const { Content } = content;
const { title, chapter, lesson } = content.frontmatter;
---

<BaseLayout title={title}>
  <div class="container" style="max-width: 1400px; margin: 30px auto; padding: 0 20px;">
    <div style="display: grid; grid-template-columns: 250px 1fr; gap: 24px; align-items: start;">
      <Sidebar currentChapter={chapter} currentLesson={lesson} />
      <div class="content-area">
        <div class="content-header">
          <p class="chapter-label">Chapter {chapter}: Agricultural Applications</p>
          <h1>{title}</h1>
        </div>
        <article class="lesson-content">
          <Content />
        </article>
        <TaskShuffle />
        <LessonNav 
          prev={{ href: '/drones/02-parts-types/review', label: 'Previous' }}
          next={{ href: '/drones/03-agricultural-applications/lesson-2', label: 'Next' }}
          progress={`${chapter}.${lesson} / 7 Chapters`}
        />
      </div>
    </div>
  </div>
</BaseLayout>
<style is:global>
  :root {
    --isu-red: #c41e3a;
    --isu-gold: #f8c600;
    --border-light: #ddd;
    --text-dark: #1a1a1a;
    --text-medium: #666;
    --isu-dark-red: #a01729;
  }

.lesson-content img {
  max-width: 700px !important;
  height: auto !important;
  display: block !important;
  margin: 24px auto !important;
  border-radius: 10px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
}
@media (max-width: 767px) {
  .lesson-content img {
    max-width: 100% !important;
  }
}

  .lesson-intro {
    background: linear-gradient(135deg, #f5f5f5 0%, #ffffff 100%);
    padding: 20px;
    border-left: 4px solid var(--isu-red);
    border-radius: 4px;
    margin-bottom: 30px;
    font-size: 1.1em;
    line-height: 1.8;
    color: var(--text-dark);
  }

  .section-intro {
    font-size: 1.05em;
    color: var(--text-medium);
    font-style: italic;
    margin-bottom: 20px;
    padding: 0 12px;
  }

  .impact-callout {
    background: linear-gradient(135deg, rgba(196, 30, 58, 0.08) 0%, rgba(255, 184, 28, 0.08) 100%);
    border-left: 5px solid var(--isu-red);
    border-radius: 6px;
    padding: 24px;
    margin: 30px 0;
  }
  .impact-callout h4 {
    color: var(--isu-red);
    margin-top: 0;
    margin-bottom: 12px;
    font-size: 1.15em;
  }
  .impact-callout p {
    color: var(--text-dark);
    line-height: 1.7;
    margin: 0;
  }

  /* Collapsible task categories */
  .task-category {
    margin: 14px 0;
    padding: 4px 22px;
    background: white;
    border: 1px solid var(--border-light);
    border-radius: 8px;
  }
  .task-category summary {
    cursor: pointer;
    padding: 16px 0;
    font-weight: 700;
    color: var(--isu-red);
    list-style: none;
    font-size: 1.05em;
  }
  .task-category summary::-webkit-details-marker {
    display: none;
  }
  .task-category summary::before {
    content: '+ ';
    color: var(--isu-red);
    font-weight: 800;
  }
  .task-category[open] summary::before {
    content: '– ';
  }
  .task-category .task-tags {
    padding-bottom: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .task-tag {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 0.85em;
    font-weight: 500;
    background: rgba(196, 30, 58, 0.08);
    color: var(--isu-dark-red);
  }
</style>

<style>
  @media (max-width: 768px) {
    div[style*="grid-template-columns"] {
      display: flex !important;
      flex-direction: column-reverse !important;
      gap: 16px !important;
    }
  }
</style>