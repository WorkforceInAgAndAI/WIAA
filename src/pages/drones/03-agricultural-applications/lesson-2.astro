---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sidebar from '../../../components/Sidebar.astro';
import LessonNav from '../../../components/LessonNav.astro';
import TaskCategorySort from '../../../components/TaskCategorySort.astro';

const content = await import('../../../content/drones/03-agricultural-applications/lesson-2.md');
const { Content } = content;
const { title, chapter, lesson } = content.frontmatter;
---

<BaseLayout title={title}>
  <div class="container" style="max-width: 1400px; margin: 30px auto; padding: 0 20px;">
    <div style="display: grid; grid-template-columns: 250px 1fr; gap: 24px; align-items: start;">
      <Sidebar currentChapter={chapter} currentLesson={lesson} />
      <div class="content-area">
        <div class="content-header">
          <p class="chapter-label">Chapter {chapter}: Agricultural Applications</p>
          <h1>{title}</h1>
        </div>
        <article class="lesson-content">
          <Content />
        </article>
        <TaskCategorySort />
        <LessonNav 
          prev={{ href: '/drones/03-agricultural-applications/lesson-1', label: 'Previous' }}
          next={{ href: '/drones/03-agricultural-applications/review', label: 'Next' }}
          progress={`${chapter}.${lesson} / 7 Chapters`}
        />
      </div>
    </div>
  </div>
</BaseLayout>
<style is:global>
  :root {
    --isu-red: #c41e3a;
    --isu-gold: #f8c600;
    --border-light: #ddd;
    --text-dark: #1a1a1a;
    --text-medium: #666;
    --isu-dark-red: #a01729;
  }
.lesson-content img {
  max-width: 700px !important;
  height: auto !important;
  display: block !important;
  margin: 24px auto !important;
  border-radius: 10px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
}
@media (max-width: 767px) {
  .lesson-content img {
    max-width: 100% !important;
  }
}
  .lesson-intro {
    background: linear-gradient(135deg, #f5f5f5 0%, #ffffff 100%);
    padding: 20px;
    border-left: 4px solid var(--isu-red);
    border-radius: 4px;
    margin-bottom: 30px;
    font-size: 1.1em;
    line-height: 1.8;
    color: var(--text-dark);
  }

  /* SWOT grid */
  .swot-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin: 24px 0 40px;
  }
  @media (min-width: 700px) {
    .swot-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .swot-quadrant {
    border-radius: 10px;
    padding: 22px 24px;
    border: 1px solid var(--border-light);
  }
  .swot-quadrant h4 {
    margin: 0 0 12px;
    font-size: 1.1em;
  }
  .swot-quadrant ul {
    margin: 0;
    padding-left: 20px;
  }
  .swot-quadrant li {
    margin: 8px 0;
    line-height: 1.5;
    color: var(--text-dark);
  }
  .swot-quadrant--strengths {
    background: rgba(46, 125, 50, 0.06);
    border-top: 4px solid #2e7d32;
  }
  .swot-quadrant--strengths h4 { color: #2e7d32; }
  .swot-quadrant--weaknesses {
    background: rgba(196, 30, 58, 0.06);
    border-top: 4px solid var(--isu-red);
  }
  .swot-quadrant--weaknesses h4 { color: var(--isu-red); }
  .swot-quadrant--opportunities {
    background: rgba(25, 118, 210, 0.06);
    border-top: 4px solid #1976d2;
  }
  .swot-quadrant--opportunities h4 { color: #1976d2; }
  .swot-quadrant--threats {
    background: rgba(230, 145, 0, 0.08);
    border-top: 4px solid #e69100;
  }
  .swot-quadrant--threats h4 { color: #b26b00; }

  /* Storm damage scenario */
  .scenario-box {
    background: #fafafa;
    border: 1px solid var(--border-light);
    border-radius: 10px;
    padding: 26px;
    margin: 24px 0 40px;
  }
  .scenario-box > p {
    margin-top: 0;
    line-height: 1.7;
  }
  .lesson-reveal {
    margin: 16px 0;
    padding: 4px 20px;
    background: #fff8e1;
    border: 1px solid var(--isu-gold);
    border-radius: 8px;
  }
  .lesson-reveal summary {
    cursor: pointer;
    padding: 14px 0;
    font-weight: 600;
    color: var(--isu-dark-red);
    list-style: none;
  }
  .lesson-reveal summary::-webkit-details-marker {
    display: none;
  }
  .lesson-reveal summary::before {
    content: '+ ';
    color: var(--isu-red);
    font-weight: 800;
  }
  .lesson-reveal[open] summary::before {
    content: '– ';
  }
  .lesson-reveal p {
    padding-bottom: 16px;
    margin: 0;
    color: var(--text-dark);
    line-height: 1.6;
  }

  /* Reflection card */
  .reflection-card {
    background: linear-gradient(135deg, rgba(196, 30, 58, 0.06), rgba(255, 184, 28, 0.06));
    border-left: 5px solid var(--isu-gold);
    border-radius: 6px;
    padding: 22px 24px;
    margin: 24px 0;
  }
  .reflection-card h4 {
    margin: 0 0 8px;
    color: var(--isu-dark-red);
  }
  .reflection-card p {
    margin: 0;
    color: var(--text-dark);
    line-height: 1.6;
  }
</style>

<style>
  @media (max-width: 768px) {
    div[style*="grid-template-columns"] {
      display: flex !important;
      flex-direction: column-reverse !important;
      gap: 16px !important;
    }
  }
</style>