<section class="gsd-calc" aria-label="GSD calculator activity">
  <h3 class="gsd-calc__title">Try it: Calculate GSD</h3>
  <p class="gsd-calc__prompt">These are the workbook's example values — change any of them to see how GSD responds.</p>

  <div class="gsd-calc__grid">
    <label class="gsd-calc__field">
      <span>Camera height (m)</span>
      <input type="number" data-height value="20" step="0.1" />
    </label>
    <label class="gsd-calc__field">
      <span>Sensor width (mm)</span>
      <input type="number" data-sensor-width value="6.96" step="0.01" />
    </label>
    <label class="gsd-calc__field">
      <span>Focal length (mm)</span>
      <input type="number" data-focal value="8.0" step="0.1" />
    </label>
    <label class="gsd-calc__field">
      <span>Image width (pixels)</span>
      <input type="number" data-image-width value="2048" step="1" />
    </label>
  </div>

  <div class="gsd-calc__result">
    <span class="gsd-calc__result-label">Calculated GSD</span>
    <span class="gsd-calc__result-value" data-result>0.00 cm/pixel</span>
  </div>

  <details class="lesson-reveal">
    <summary>How could you increase the GSD of the imagery?</summary>
    <p>Increase the flight altitude, use a larger sensor, use a shorter focal length, or reduce the image width (fewer pixels) — any of these makes each pixel cover more ground, which increases (worsens) the GSD and lowers spatial resolution.</p>
  </details>
</section>

<script>
  function init(root) {
    const height = root.querySelector('[data-height]');
    const sensorWidth = root.querySelector('[data-sensor-width]');
    const focal = root.querySelector('[data-focal]');
    const imageWidth = root.querySelector('[data-image-width]');
    const result = root.querySelector('[data-result]');

    function calculate() {
      const h = parseFloat(height.value) * 1000; // m to mm
      const sw = parseFloat(sensorWidth.value);
      const f = parseFloat(focal.value);
      const iw = parseFloat(imageWidth.value);
      if (!h || !sw || !f || !iw) {
        result.textContent = '—';
        return;
      }
      const gsdMm = (sw * h) / (f * iw);
      const gsdCm = gsdMm / 10;
      result.textContent = `${gsdCm.toFixed(3)} cm/pixel`;
    }

    [height, sensorWidth, focal, imageWidth].forEach((el) => el.addEventListener('input', calculate));
    calculate();
  }
  document.querySelectorAll('.gsd-calc').forEach(init);
</script>

