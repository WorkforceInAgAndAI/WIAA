---
const satellites = [
  {
    id: "landsat",
    name: "Landsat 9",
    temporal: "16 days",
    cost: "Free to access",
    sensors: [
      "Operational Land Imager (OLI): Coastal/aerosol, Blue, Green, Red, NIR, 2 Shortwave IR, Panchromatic, Cirrus",
      "Thermal Infrared Sensor (TIRS): 2 thermal-infrared spectral bands"
    ],
    cite: "1"
  },
  {
    id: "sentinel",
    name: "Sentinel-2",
    temporal: "5 days",
    cost: "Free to access",
    sensors: [
      "Multispectral Imager: Aerosol, Blue, Green, Red, 3 Red edge, NIR (calibration), NIR (narrow), Water vapor, Cirrus, SWIR",
      "Applications: Vegetation, soil, and water"
    ],
    cite: "19"
  },
  {
    id: "pleiades",
    name: "Pléiades Neo",
    temporal: "2 times per day",
    cost: "Archival data: $22.50/km\u00B2 for natural color, 4- or 6-band data",
    sensors: [
      "Pléiades Neo Imager: Deep blue, Blue, Green, Red, Red edge, NIR, Panchromatic"
    ],
    cite: "20, 32"
  },
  {
    id: "skysat",
    name: "SkySat",
    temporal: "6-7 times per day",
    cost: "Individual tasks: $6-$40/km\u00B2. Annual subscriptions: $2,700-$9,650",
    sensors: [
      "3 Complementary Metal-Oxide Semiconductor (CMOS): Blue, Green, Red, NIR, Panchromatic"
    ],
    cite: "22, 33"
  }
];
---
<div class="resource-explorer">
  <h4>Explore: Satellite Resources</h4>
  <p class="resource-explorer__prompt">Click a satellite to see its temporal resolution, sensors, and data cost.</p>
  <div class="resource-explorer__grid">
    {satellites.map(s => (
      <button class="resource-explorer__card" data-target={s.id}>
        <span class="resource-explorer__name">{s.name}</span>
        <span class="resource-explorer__temporal">{s.temporal}</span>
      </button>
    ))}
  </div>
  <div class="resource-explorer__detail" id="resource-explorer-detail">
    <p>Click a satellite above to learn more.</p>
  </div>
</div>

<style is:global>
  .resource-explorer {
    background: white;
    border: 1px solid var(--border-light);
    border-radius: 8px;
    padding: 24px;
    margin: 30px 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }
  .resource-explorer h4 {
    color: var(--isu-red);
    font-size: 1.2em;
    margin-bottom: 8px;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }
  .resource-explorer__prompt {
    color: var(--text-medium);
    margin-bottom: 16px;
  }
  .resource-explorer__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 16px;
  }
  .resource-explorer__card {
    padding: 14px;
    border: 1px solid var(--isu-gold);
    background: white;
    border-radius: 6px;
    cursor: pointer;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .resource-explorer__card.active {
    background: var(--isu-red);
    border-color: var(--isu-red);
  }
  .resource-explorer__card.active .resource-explorer__name,
  .resource-explorer__card.active .resource-explorer__temporal {
    color: white;
  }
  .resource-explorer__name {
    color: var(--isu-red);
    font-weight: 700;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }
  .resource-explorer__temporal {
    color: var(--text-medium);
    font-size: 12px;
  }
  .resource-explorer__detail {
    background: #f9f7f4;
    border-radius: 6px;
    padding: 18px;
    color: var(--text-dark);
    line-height: 1.7;
    min-height: 60px;
  }
  .resource-explorer__detail h5 {
    color: var(--isu-red);
    margin-bottom: 10px;
  }
  .resource-explorer__detail ul {
    margin-left: 18px;
    margin-bottom: 10px;
  }
  .resource-explorer__detail li {
    margin-bottom: 6px;
    font-size: 14px;
  }
  .resource-explorer__cost {
    font-weight: 600;
    color: var(--isu-dark-red);
  }
  @media (min-width: 768px) {
    .resource-explorer__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

<script define:vars={{ satellites }}>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.resource-explorer__card');
    const detail = document.getElementById('resource-explorer-detail');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const target = btn.dataset.target;
        const sat = satellites.find(s => s.id === target);
        if (detail && sat) {
          const sensorList = sat.sensors.map(s => `<li>${s}</li>`).join('');
          detail.innerHTML = `
            <h5>${sat.name} <sup>${sat.cite}</sup></h5>
            <p><strong>Temporal resolution:</strong> ${sat.temporal}</p>
            <ul>${sensorList}</ul>
            <p class="resource-explorer__cost">${sat.cost}</p>
          `;
        }
      });
    });
  });
</script>