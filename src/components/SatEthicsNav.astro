---
const concepts = [
  { id: "ethics-privacy", label: "Privacy & Unequal Access" },
  { id: "ethics-conflicting", label: "Conflicting Uses" },
  { id: "ethics-protections", label: "Data Protections" },
  { id: "ethics-sovereignty", label: "Data Sovereignty" }
];
---
<div class="ethics-nav">
  <p class="ethics-nav__label">Jump to a concept:</p>
  <div class="ethics-nav__track">
    {concepts.map(c => (
      <button class="ethics-nav__btn" data-target={c.id}>{c.label}</button>
    ))}
  </div>
</div>

<style is:global>
  .ethics-nav {
    background: #f9f7f4;
    border-radius: 8px;
    padding: 16px 20px;
    margin-bottom: 20px;
  }
  .ethics-nav__label {
    margin: 0 0 10px 0;
    font-weight: 600;
    color: var(--text-dark);
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }
  .ethics-nav__track {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .ethics-nav__btn {
    padding: 8px 14px;
    border: 1px solid var(--isu-gold);
    background: white;
    color: var(--isu-red);
    border-radius: 20px;
    cursor: pointer;
    font-size: 13px;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }
  .ethics-nav__btn:hover {
    background: var(--isu-gold);
    color: white;
  }
  .ethics-block {
    scroll-margin-top: 90px;
    transition: background 0.6s ease;
    border-radius: 6px;
    padding: 4px 8px;
    margin-left: -8px;
    margin-right: -8px;
  }
  .ethics-block.highlight {
    background: rgba(248, 198, 0, 0.18);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.ethics-nav__btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = (btn as HTMLElement).dataset.target;
        if (!targetId) return;
        const target = document.getElementById(targetId);
        if (!target) return;
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        target.classList.add('highlight');
        setTimeout(() => target.classList.remove('highlight'), 1500);
      });
    });
  });
</script>