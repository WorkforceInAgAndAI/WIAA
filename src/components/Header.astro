---
const currentPath = Astro.url.pathname;
---
<header class="navbar">
  <div class="nav-container">
    <a href="/WIAA/" class="logo-link">
      <div class="logo-text">WIAA</div>
    </a>
    
    <button class="mobile-menu-btn" aria-label="Toggle menu" id="mobile-menu-btn">
      <i class="fas fa-bars"></i>
    </button>
    
    <nav class="desktop-nav" id="nav-menu">
      <a href="/WIAA" class={currentPath === '/' ? 'active' : ''}>Home</a>
      <a href="/WIAA/drones" class={currentPath.startsWith('/drones') ? 'active' : ''}>Drone Program</a>
      <a href="/WIAA/rovers" class={currentPath.startsWith('/rovers') ? 'active' : ''}>Rover Program</a>
      <a href="/WIAA/satellites" class={currentPath.startsWith('/satellites') ? 'active' : ''}>Satellite Program</a>
      <a href="/WIAA/outreach" class={currentPath === '/outreach' ? 'active' : ''}>Outreach</a>
    </nav>
  </div>
</header>

<style>
  .navbar {
    height: 60px;
    width: 100%;
    border-bottom: 1px solid var(--border-light);
    background: white;
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 40px;
  }

  .logo-link {
    display: flex;
    align-items: center;
    color: var(--isu-red);
    text-decoration: none;
    transition: color 0.2s;
  }

  .logo-link:hover {
    color: var(--isu-dark-red);
  }

  .logo-text {
    color: var(--isu-red);
    font-size: 24px;
    font-weight: 700;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
    letter-spacing: 0;
  }

  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    font-size: 20px;
    color: var(--isu-red);
    cursor: pointer;
    padding: 10px;
  }

  .desktop-nav {
    display: flex;
    gap: 30px;
  }

  .desktop-nav a {
    padding: 10px 0;
    color: var(--text-dark);
    font-weight: 400;
    text-decoration: none;
    transition: color 0.2s;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }

  .desktop-nav a:hover {
    color: var(--isu-red);
  }

  .desktop-nav a.active {
    color: var(--isu-red);
    border-bottom: 1px solid var(--border-light);
    font-weight: 400;
  }

  /* Mobile styles */
  @media (max-width: 767px) {
    .nav-container {
      padding: 0 25px;
    }

    .mobile-menu-btn {
      display: block;
    }

    .desktop-nav {
      position: absolute;
      top: 60px;
      left: 0;
      right: 0;
      background: white;
      flex-direction: column;
      gap: 0;
      border-bottom: 1px solid var(--border-light);
      display: none;
    }

    .desktop-nav.open {
      display: flex;
    }

    .desktop-nav a {
      padding: 15px 25px;
      border-bottom: 1px solid var(--border-light);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .desktop-nav a.active {
      background: white;
      border-bottom: 1px solid var(--border-light);
      color: var(--isu-red);
    }
  }
</style>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const navMenu = document.getElementById('nav-menu');
  if (mobileMenuBtn && navMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      navMenu.classList.toggle('open');
    });
    // Close menu when clicking a link
    const navLinks = navMenu.querySelectorAll('a');
    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        navMenu.classList.remove('open');
      });
    });
    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      if (!mobileMenuBtn.contains(e.target) && !navMenu.contains(e.target)) {
        navMenu.classList.remove('open');
      }
    });
  }
</script>