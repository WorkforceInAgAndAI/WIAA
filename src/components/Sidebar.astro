---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface Props {
  currentChapter: number;
  currentLesson?: number;
}

const { currentChapter, currentLesson } = Astro.props;

const chapters = [
  {
    num: 0,
    title: "Learning goals",
    lessons: [
      { num: 1, title: "Learning objectives", href: base + "/drones/00-learning-goals/lesson-1" },
      { num: 2, title: "Next generation science standards", href: base + "/drones/00-learning-goals/lesson-2" }
    ]
  },
  {
    num: 1,
    title: "Introduction to Drones",
    lessons: [
      { num: 1, title: "Aerial Imagery", href: base + "/drones/01-introduction/lesson-1" },
      { num: 2, title: "What is a Drone?", href: base + "/drones/01-introduction/lesson-2" },
	{ num: 3, title: "Use of Drones in Agriculture", href: base + "/drones/01-introduction/lesson-3" },
	{ num: 4, title: "Principles of Flight", href: base + "/drones/01-introduction/lesson-4" },
      { num: 5, title: "Concept review", href: base + "/drones/01-introduction/review" }
    ]
  },
  {
    num: 2,
    title: "Drone Parts & Types",
    lessons: [
      { num: 1, title: "Main Components", href: base + "/drones/02-parts-types/lesson-1" },
      { num: 2, title: "Types of Agricultural Drones", href: base + "/drones/02-parts-types/lesson-2" },
      { num: 3, title: "Concept review", href: base + "/drones/02-parts-types/review" }
    ]
  },
  {
    num: 3,
    title: "Agriculture Applications",
    lessons: [
      { num: 1, title: "Agronomists Are Busy", href: base + "/drones/03-agricultural-applications/lesson-1"},
      { num: 2, title: "Where Drones Can Help", href: base + "/drones/03-agricultural-applications/lesson-2" },
      { num: 3, title: "Concept review", href: base + "/drones/03-agricultural-applications/review" }
    ]
  },
  {
    num: 4,
    title: "FAA Part 107 & safety",
    lessons: [
      { num: 1, title: "Federal Aviation Administration and Part 107", href: base + "/drones/04-faa-safety/lesson-1" },
      { num: 2, title: "Eligibility", href: base + "/drones/04-faa-safety/lesson-2" },
	{ num: 3, title: "Drone Registration and Remote ID", href: base + "/drones/04-faa-safety/lesson-3" },
	{ num: 4, title: "Core Flight Rules and Regulations", href: base + "/drones/04-faa-safety/lesson-4" },
	{ num: 5, title: "Airspaces and Aeronautical Charts", href: base + "/drones/04-faa-safety/lesson-5" },
	{ num: 6, title: "Best Operating Practices", href: base + "/drones/04-faa-safety/lesson-6" },
      { num: 7, title: "Concept review", href: base + "/drones/04-faa-safety/review" }
    ]
  },
  {
    num: 5,
    title: "Planning and Positioning",
    lessons: [
      { num: 1, title: "Flight Parameters", href: base + "/drones/05-planning-positioning/lesson-1" },
      { num: 2, title: "In-Field Preparation", href: base + "/drones/05-planning-positioning/lesson-2" },
      { num: 3, title: "Coordinate Systems", href: base + "/drones/05-planning-positioning/lesson-3" },
      { num: 4, title: "Concept review", href: base + "/drones/05-planning-positioning/review" }
    ]
  },
  {
    num: 6,
    title: "Sensors and Their Applications",
    lessons: [
      { num: 1, title: "Types of Agricultural Sensors", href: base + "/drones/06-sensors/lesson-1" },
      { num: 2, title: "Camera Parameters", href: base + "/drones/06-sensors/lesson-2" },
      { num: 3, title: "Concept review", href: base + "/drones/06-sensors/review" }
    ]
  },
{
    num: 7,
    title: "Vegetation Indices",
    lessons: [
      { num: 1, title: "Reflectance and Plant Health", href: base + "/drones/07-vegetation-indices/lesson-1" },
      { num: 2, title: "NDVI Formula", href: base + "/drones/07-vegetation-indices/lesson-2" },
      { num: 3, title: "Concept review", href: base + "/drones/07-vegetation-indices/review" }
    ]
  },
  {
    num: 8,
    title: "AI in Agriculture",
    lessons: [
      { num: 1, title: "What is Artificial Intelligence?", href: base + "/drones/08-ai-agriculture/lesson-1" },
      { num: 2, title: "AI Tasks in Agriculture", href: base + "/drones/08-ai-agriculture/lesson-2" },
      { num: 3, title: "AI Toolbox", href: base + "/drones/08-ai-agriculture/lesson-3" },
      { num: 4, title: "How are AI Models are Built", href: base + "/drones/08-ai-agriculture/lesson-4" },
      { num: 5, title: "Concept review", href: base + "/drones/08-ai-agriculture/review" }
    ]
  },
{
    num: 9,
    title: "Drone Imagery Processing Pipeline",
    lessons: [
      { num: 1, title: "Overview and Flight Planning", href: base + "/drones/09-imagery-pipeline/lesson-1" },
      { num: 2, title: "Ground Control Points and Calibration", href: base + "/drones/09-imagery-pipeline/lesson-2" },
      { num: 3, title: "Processing Outputs and Field Analysis", href: base + "/drones/09-imagery-pipeline/lesson-3" },
      { num: 4, title: "Plot Extraction", href: base + "/drones/09-imagery-pipeline/lesson-4" },
      { num: 5, title: "Concept review", href: base + "/drones/09-imagery-pipeline/review" }
    ]
  },

  {
    num: 10,
    title: "Solution Innovator",
    lessons: [
      { num: 1, title: "Overview", href: base + "/drones/10-solution-innovator/lesson-1" },
      { num: 2, title: "Drone Station", href: base + "/drones/10-solution-innovator/lesson-2" },
	{ num: 3, title: "Rover Station", href: base + "/drones/10-solution-innovator/lesson-3" },
	{ num: 4, title: "AI Station", href: base + "/drones/10-solution-innovator/lesson-4" },
	{ num: 5, title: "Sensor Station", href: base + "/drones/10-solution-innovator/lesson-5" },
      { num: 6, title: "The Solution Innovator Challenge", href: base + "/drones/10-solution-innovator/lesson-6" },
      { num: 7, title: "Concept review", href: base + "/drones/10-solution-innovator/review" }
    ]
  },
{
    num: 11,
    title: "Drone Mission",
    lessons: [
      { num: 1, title: "Overview", href: base + "/drones/11-drone-mission/lesson-1" },
      { num: 2, title: "Drones for Scouting Fields", href: base + "/drones/11-drone-mission/lesson-2" },
      { num: 3, title: "Concept review", href: base + "/drones/11-drone-mission/review" }
    ]
  },
  {
    num: 12,
    title: "Careers in drones & AI",
    lessons: [
      { num: 1, title: "Why these skills matter", href: base + "/drones/12-careers/lesson-1" },
      { num: 2, title: "Skills you can build now", href: base + "/drones/12-careers/lesson-2" },
      { num: 3, title: "Concept review", href: base + "/drones/12-careers/review" }
    ]
  },
  {
    num: 13,
    title: "References",
    lessons: [
      { num: 1, title: "References", href: base + "/drones/14-references/lesson-1" }
    ]
  }
];
---

<aside class="sidebar">
  <h3>Content</h3>
  <nav class="chapter-nav">
    {chapters.map(chapter => (
      <div class="chapter-section">
        <a
          href={chapter.lessons[0].href}
          class={`chapter-btn ${currentChapter === chapter.num ? 'active' : ''}`}
        >
          {chapter.title}
        </a>
        {currentChapter === chapter.num && (
          <div class="lesson-list">
            {chapter.lessons.map(lesson => (
              <a
                href={lesson.href}
                class={`lesson-btn ${currentLesson === lesson.num ? 'active' : ''}`}
              >
                {lesson.title}
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
  </nav>
</aside>

<style>
  .sidebar {
    background: white;
    padding: 20px;
    border: 1px solid var(--border-light);
    height: fit-content;
    width: 250px;
  }

  .sidebar h3 {
    margin-bottom: 15px;
    color: var(--text-dark);
    font-size: 24px;
    border-bottom: 1px solid var(--border-light);
    padding-bottom: 10px;
    font-weight: 400;
    line-height: 1.3;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }

  .chapter-nav {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .chapter-btn {
    display: block;
    padding: 12px 28px;
    background: var(--isu-red);
    color: white;
    border: none;
    text-align: left;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
    text-decoration: none;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }

  .chapter-btn:hover {
    background: var(--isu-dark-red);
  }

  .chapter-btn.active {
    background: var(--isu-dark-red);
  }

  .lesson-list {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin-top: 5px;
  }

  .lesson-btn {
    display: block;
    padding: 8px 12px;
    margin-left: 8px;
    background: white;
    color: var(--text-medium);
    border: 1px solid var(--border-light);
    text-align: left;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }

  .lesson-btn:hover {
    border-color: var(--isu-red);
    color: var(--isu-red);
    background: white;
  }

  .lesson-btn.active {
    background: white;
    border-color: var(--isu-red);
    color: var(--isu-red);
    font-weight: 600;
  }
</style>