<div class="future-role">
  <h4>Activity 27: Your Future Role</h4>
  <div class="future-role__item">
    <label>What job would you like?</label>
    <textarea rows="2" placeholder="Type your answer here..."></textarea>
  </div>
  <div class="future-role__item">
    <label>What problems would you solve?</label>
    <textarea rows="2" placeholder="Type your answer here..."></textarea>
  </div>
  <div class="future-role__item">
    <label>One step you can take this year:</label>
    <textarea rows="2" placeholder="Type your answer here..."></textarea>
  </div>
  <p class="future-role__note">This isn't saved anywhere &mdash; it's just a space to think it through before you write it down elsewhere.</p>
</div>

<style is:global>
  .future-role {
    background: white;
    border: 1px solid var(--border-light);
    border-radius: 8px;
    padding: 24px;
    margin: 30px 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }
  .future-role h4 {
    color: var(--isu-red);
    font-size: 1.2em;
    margin-bottom: 16px;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }
  .future-role__item {
    margin-bottom: 16px;
  }
  .future-role__item label {
    display: block;
    font-weight: 600;
    color: var(--text-dark);
    margin-bottom: 8px;
    font-size: 14px;
  }
  .future-role__item textarea {
    width: 100%;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    padding: 12px;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
    font-size: 14px;
    color: var(--text-dark);
    resize: vertical;
    box-sizing: border-box;
  }
  .future-role__note {
    color: var(--text-light);
    font-size: 0.85em;
    font-style: italic;
    margin-top: 6px;
    margin-bottom: 0;
  }
</style>