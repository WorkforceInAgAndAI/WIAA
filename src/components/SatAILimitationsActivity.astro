<div class="ai-limitations">
  <h4>Activity 18: AI Limitations</h4>
  <p class="ai-limitations__prompt">What happens if the data a model is trained on is labeled incorrectly?</p>
  <textarea class="ai-limitations__input" rows="5" placeholder="Type your answer here..."></textarea>
  <p class="ai-limitations__note">This isn't saved anywhere &mdash; it's just a space to think it through before you write it down elsewhere.</p>
</div>

<style is:global>
  .ai-limitations {
    background: white;
    border: 1px solid var(--border-light);
    border-radius: 8px;
    padding: 24px;
    margin: 30px 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }
  .ai-limitations h4 {
    color: var(--isu-red);
    font-size: 1.2em;
    margin-bottom: 10px;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }
  .ai-limitations__prompt {
    color: var(--text-dark);
    line-height: 1.6;
    margin-bottom: 16px;
  }
  .ai-limitations__input {
    width: 100%;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    padding: 14px;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
    font-size: 16px;
    color: var(--text-dark);
    resize: vertical;
    box-sizing: border-box;
  }
  .ai-limitations__note {
    color: var(--text-light);
    font-size: 0.85em;
    font-style: italic;
    margin-top: 10px;
    margin-bottom: 0;
  }
</style>