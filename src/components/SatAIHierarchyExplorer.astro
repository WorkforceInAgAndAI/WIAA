---
const layers = [
  { id: "ai", label: "Artificial Intelligence", size: 100, def: "Smart computers that think like humans.", example: "A smart computer system that uses a human-supplied image to identify pests on maize and decide what to do, helping farmers with decision making." },
  { id: "ml", label: "Machine Learning", size: 82, def: "AI that learns from many examples (data) with human supervision instead of being told every rule.", example: "We show the computer lots of pictures of insects and provide labels for \u2018pest\u2019 or \u2018beneficial,\u2019 so the computer can learn patterns and identify pests on maize leaf." },
  { id: "dl", label: "Deep Learning", size: 64, def: "A type of machine learning that uses layers that can process and recognize patterns from unstructured data without human supervision.", example: "We use deep learning to enable the computer to detect fine details in insect pictures and recognize them accurately through pattern recognition without human supervision." },
  { id: "genai", label: "Generative AI", size: 46, def: "Deep learning models that can create multimedia content, including text, images, sounds, and videos.", example: "A generative AI model looks at a picture and generates a clear explanation, such as \u2018This is fall armyworm, a maize pest that eats leaves.\u2019" },
  { id: "foundation", label: "Foundation Models", size: 28, def: "Very large generative AI models trained on vast amounts of data, able to perform a variety of tasks. ChatGPT, Gemini, or Claude are examples.", example: "Instead of training from scratch, we start with a large foundation model that already understands language and images and fine-tune it on crop and insect data." }
];
const agentic = { id: "agentic", label: "Agentic AI", def: "AI systems that use foundation models to target a specific area as helpers &mdash; learning new information, creating plans, using tools, and assisting with tasks.", example: "An Agentic AI system for a farm watches for new images from the field, asks the foundation model what insect it sees, and decides whether to alert the farmer or update a spray schedule." };
---
<div class="ai-hierarchy">
  <h4>Explore: How AI Concepts Build on Each Other</h4>
  <p class="ai-hierarchy__prompt">Each ring sits inside the one before it &mdash; click a ring to see its definition and example. Agentic AI is built on top of foundation models, so it branches off to the side.</p>
  <div class="ai-hierarchy__layout">
    <div class="ai-hierarchy__rings" id="ai-hierarchy-rings">
      {layers.map((l, i) => (
        <button
          class="ai-hierarchy__ring"
          data-target={l.id}
          style={`width: ${l.size}%; padding-top: ${l.size}%; z-index: ${i + 1};`}
        >
          <span>{l.label}</span>
        </button>
      ))}
    </div>
    <button class="ai-hierarchy__branch" data-target={agentic.id}>{agentic.label}</button>
  </div>
  <div class="ai-hierarchy__detail" id="ai-hierarchy-detail">
    <p>Click a concept above to see its definition and example.</p>
  </div>
</div>

<style is:global>
  .ai-hierarchy {
    background: white;
    border: 1px solid var(--border-light);
    border-radius: 8px;
    padding: 24px;
    margin: 30px 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }
  .ai-hierarchy h4 {
    color: var(--isu-red);
    font-size: 1.2em;
    margin-bottom: 8px;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }
  .ai-hierarchy__prompt {
    color: var(--text-medium);
    margin-bottom: 20px;
    line-height: 1.6;
  }
  .ai-hierarchy__layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
  }
  .ai-hierarchy__rings {
    position: relative;
    width: 260px;
    height: 260px;
  }
  .ai-hierarchy__ring {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    height: 0;
    border-radius: 50%;
    border: 2px solid var(--isu-gold);
    background: rgba(248, 198, 0, 0.08);
    cursor: pointer;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }
  .ai-hierarchy__ring span {
    position: relative;
    top: 8px;
    font-size: 11px;
    font-weight: 700;
    color: var(--isu-red);
    text-align: center;
    padding: 0 6px;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }
  .ai-hierarchy__ring.active {
    border-color: var(--isu-red);
    background: rgba(196, 30, 58, 0.1);
  }
  .ai-hierarchy__branch {
    padding: 12px 20px;
    border: 2px solid var(--isu-gold);
    background: rgba(248, 198, 0, 0.08);
    border-radius: 20px;
    cursor: pointer;
    font-weight: 700;
    color: var(--isu-red);
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }
  .ai-hierarchy__branch.active {
    border-color: var(--isu-red);
    background: rgba(196, 30, 58, 0.1);
  }
  .ai-hierarchy__detail {
    background: #f9f7f4;
    border-radius: 6px;
    padding: 18px;
    color: var(--text-dark);
    line-height: 1.7;
    min-height: 60px;
  }
  .ai-hierarchy__detail h5 {
    color: var(--isu-red);
    margin-bottom: 10px;
  }
  .ai-hierarchy__detail p {
    margin-bottom: 10px;
    font-size: 14px;
  }
  .ai-hierarchy__detail .example {
    font-style: italic;
    color: var(--text-medium);
  }
</style>

<script define:vars={{ layers, agentic }}>
  document.addEventListener('DOMContentLoaded', () => {
    const all = [...layers, agentic];
    const buttons = document.querySelectorAll('.ai-hierarchy__ring, .ai-hierarchy__branch');
    const detail = document.getElementById('ai-hierarchy-detail');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const target = btn.dataset.target;
        const item = all.find(l => l.id === target);
        if (detail && item) {
          detail.innerHTML = `
            <h5>${item.label}</h5>
            <p>${item.def}</p>
            <p class="example">${item.example}</p>
          `;
        }
      });
    });
  });
</script>