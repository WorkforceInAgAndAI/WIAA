---
// Click-to-flip check for the UAV vs UAS distinction taught in lesson 1.
---
<section class="flip-activity" aria-label="UAV vs UAS practice">
  <h3 class="flip-activity__title">Try it: UAV or UAS?</h3>
  <p class="flip-activity__prompt">Read each description, then click the card to check yourself.</p>

  <div class="flip-grid">
    <button class="flip-card" type="button">
      <span class="flip-card__inner">
        <span class="flip-card__face flip-card__face--front">
          "Just the aircraft itself — no controller or sensors attached."
        </span>
        <span class="flip-card__face flip-card__face--back">UAV — the vehicle alone.</span>
      </span>
    </button>

    <button class="flip-card" type="button">
      <span class="flip-card__inner">
        <span class="flip-card__face flip-card__face--front">
          "The aircraft, the pilot flying it, and the sensor mounted underneath, all working together."
        </span>
        <span class="flip-card__face flip-card__face--back">UAS — the full system.</span>
      </span>
    </button>

    <button class="flip-card" type="button">
      <span class="flip-card__inner">
        <span class="flip-card__face flip-card__face--front">
          "The software a researcher uses to process the images after the flight."
        </span>
        <span class="flip-card__face flip-card__face--back">UAS — supporting software still counts.</span>
      </span>
    </button>
  </div>
</section>

<style>
  .flip-activity {
    margin: 40px 0;
    padding: 28px;
    background: #fafafa;
    border: 1px solid var(--border-light, #ddd);
    border-radius: 10px;
  }
  .flip-activity__title {
    margin: 0 0 6px 0;
    color: var(--isu-red, #c41e3a);
    font-size: 1.15em;
  }
  .flip-activity__prompt {
    margin: 0 0 20px 0;
    color: var(--text-medium, #666);
    font-size: 0.95em;
  }
  .flip-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 700px) {
    .flip-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .flip-card {
    all: unset;
    cursor: pointer;
    perspective: 1000px;
    height: 150px;
    display: block;
  }
  .flip-card__inner {
    position: relative;
    width: 100%;
    height: 100%;
    display: block;
    transition: transform 0.5s;
    transform-style: preserve-3d;
  }
  .flip-card.is-flipped .flip-card__inner {
    transform: rotateY(180deg);
  }
  .flip-card__face {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 16px;
    border-radius: 8px;
    backface-visibility: hidden;
    font-size: 0.92em;
    line-height: 1.4;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }
  .flip-card__face--front {
    background: white;
    color: var(--text-dark, #1a1a1a);
    border: 1px solid var(--border-light, #ddd);
  }
  .flip-card__face--back {
    background: linear-gradient(135deg, var(--isu-red, #c41e3a), #a01729);
    color: white;
    font-weight: 700;
    transform: rotateY(180deg);
  }
  .flip-card:focus-visible .flip-card__face--front {
    outline: 3px solid var(--isu-gold, #f8c600);
  }
</style>

<script>
  document.querySelectorAll('.flip-card').forEach((card) => {
    card.addEventListener('click', () => {
      card.classList.toggle('is-flipped');
    });
  });
</script>