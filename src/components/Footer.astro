---
const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // Remove trailing slash if present
---
<footer class="app-footer">
  <div class="footer-container">
    <div class="footer-info">
      <h4>Workforce in Agriculture and AI</h4>
      <p>Inspiring future leaders in science</p>
    </div>
    <nav class="footer-links">
      <a href={base + '/about'}>About</a>
      <a href={base + '/contact'}>Contact</a>
      <a href={base + '/feedback'}>Feedback</a>
      <a href={base + '/privacy'}>Privacy & Terms</a>
    </nav>
  </div>
</footer>

<style>
  .app-footer {
    border-top: 1px solid var(--border-light);
    background: white;
    padding: 60px 40px;
    margin-top: auto;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 30px;
  }

  .footer-info h4 {
    font-weight: 400;
    color: var(--text-dark);
    margin-bottom: 8px;
    font-size: 24px;
    line-height: 1.3;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }

  .footer-info p {
    font-size: 12px;
    color: var(--text-light);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
    font-weight: 400;
  }

  .footer-links {
    display: flex;
    gap: 30px;
    flex-wrap: wrap;
  }

  .footer-links a {
    color: var(--text-dark);
    font-weight: 400;
    text-decoration: none;
    transition: color 0.2s;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }

  .footer-links a:hover {
    color: var(--isu-red);
  }

  @media (max-width: 767px) {
    .app-footer {
      padding: 40px 25px;
    }

    .footer-container {
      flex-direction: column;
      text-align: center;
      gap: 20px;
    }

    .footer-info h4 {
      font-size: 20px;
      margin-bottom: 5px;
    }

    .footer-links {
      justify-content: center;
      gap: 20px;
    }

    .footer-links a {
      font-size: 12px;
    }
  }
</style>