---
const orbits = [
  { id: "leo", label: "Low Earth Orbit" },
  { id: "meo", label: "Medium Earth Orbit" },
  { id: "heo", label: "High Earth Orbit" }
];
const applications = [
  { id: "meo", label: "GPS, navigation, and communication" },
  { id: "heo", label: "Weather monitoring" },
  { id: "leo", label: "High coverage daily field monitoring" }
];
---
<div class="orbit-match" id="orbit-match">
  <h4>Activity: Orbit Applications</h4>
  <p class="orbit-match__prompt">Click an orbit type, then click the application it matches.</p>
  <div class="orbit-match__columns">
    <div class="orbit-match__col">
      {orbits.map(o => (
        <button class="orbit-match__btn" data-orbit={o.id} data-role="orbit">{o.label}</button>
      ))}
    </div>
    <div class="orbit-match__col">
      {applications.map(a => (
        <button class="orbit-match__btn" data-orbit={a.id} data-role="application">{a.label}</button>
      ))}
    </div>
  </div>
  <p class="orbit-match__status" id="orbit-match-status"></p>
</div>

<style is:global>
  .orbit-match {
    background: white;
    border: 1px solid var(--border-light);
    border-radius: 8px;
    padding: 24px;
    margin: 30px 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }
  .orbit-match h4 {
    color: var(--isu-red);
    font-size: 1.2em;
    margin-bottom: 10px;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }
  .orbit-match__prompt {
    color: var(--text-dark);
    line-height: 1.6;
    margin-bottom: 20px;
  }
  .orbit-match__columns {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .orbit-match__col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .orbit-match__btn {
    padding: 12px 16px;
    border: 1px solid var(--border-light);
    background: white;
    color: var(--text-dark);
    text-align: left;
    cursor: pointer;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
    font-size: 15px;
    line-height: 1.5;
    border-radius: 4px;
    transition: border-color 0.2s, background 0.2s;
  }
  .orbit-match__btn:hover:not(:disabled) {
    border-color: var(--isu-red);
  }
  .orbit-match__btn.selected {
    border-color: var(--isu-red);
    background: rgba(196, 30, 58, 0.06);
  }
  .orbit-match__btn.matched {
    border-color: #2e7d32;
    background: rgba(46, 125, 50, 0.08);
    color: #2e7d32;
    cursor: default;
  }
  .orbit-match__btn.wrong {
    border-color: var(--isu-red);
    background: rgba(196, 30, 58, 0.1);
  }
  .orbit-match__status {
    margin-top: 16px;
    margin-bottom: 0;
    font-weight: 600;
    color: var(--isu-red);
    min-height: 1.2em;
  }
  @media (min-width: 768px) {
    .orbit-match__columns {
      flex-direction: row;
    }
    .orbit-match__col {
      flex: 1;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('orbit-match');
    if (!container) return;
    const status = document.getElementById('orbit-match-status');
    let selectedOrbit: HTMLElement | null = null;
    let selectedApp: HTMLElement | null = null;
    let matchedCount = 0;
    const totalPairs = 3;

    const buttons = container.querySelectorAll<HTMLButtonElement>('.orbit-match__btn');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const role = btn.dataset.role;
        if (btn.classList.contains('matched')) return;

        if (role === 'orbit') {
          if (selectedOrbit) selectedOrbit.classList.remove('selected');
          selectedOrbit = btn;
          btn.classList.add('selected');
        } else if (role === 'application') {
          if (selectedApp) selectedApp.classList.remove('selected');
          selectedApp = btn;
          btn.classList.add('selected');
        }

        if (selectedOrbit && selectedApp) {
          const isMatch = selectedOrbit.dataset.orbit === selectedApp.dataset.orbit;
          if (isMatch) {
            selectedOrbit.classList.remove('selected');
            selectedApp.classList.remove('selected');
            selectedOrbit.classList.add('matched');
            selectedApp.classList.add('matched');
            selectedOrbit.disabled = true;
            selectedApp.disabled = true;
            matchedCount++;
            if (status) {
              status.textContent = matchedCount === totalPairs
                ? 'All matched! Nice work.'
                : `${matchedCount} of ${totalPairs} matched.`;
            }
            selectedOrbit = null;
            selectedApp = null;
          } else {
            selectedOrbit.classList.add('wrong');
            selectedApp.classList.add('wrong');
            if (status) status.textContent = 'Not quite, try again.';
            setTimeout(() => {
              selectedOrbit?.classList.remove('selected', 'wrong');
              selectedApp?.classList.remove('selected', 'wrong');
              selectedOrbit = null;
              selectedApp = null;
            }, 700);
          }
        }
      });
    });
  });
</script>