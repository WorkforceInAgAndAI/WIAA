<div class="sat-reflection">
  <h4>Activity: Satellite Uses in Agriculture</h4>
  <p class="sat-reflection__prompt">List three ways satellites can be used in agriculture.</p>
  <textarea class="sat-reflection__input" rows="5" placeholder="Type your answer here..."></textarea>
  <p class="sat-reflection__note">This isn't saved anywhere &mdash; it's just a space to think it through before you write it down elsewhere.</p>
</div>

<style>
  .sat-reflection {
    background: white;
    border: 1px solid var(--border-light);
    border-radius: 8px;
    padding: 24px;
    margin: 30px 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }
  .sat-reflection h4 {
    color: var(--isu-red);
    font-size: 1.2em;
    margin-bottom: 10px;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }
  .sat-reflection__prompt {
    color: var(--text-dark);
    line-height: 1.6;
    margin-bottom: 16px;
  }
  .sat-reflection__input {
    width: 100%;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    padding: 14px;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
    font-size: 16px;
    color: var(--text-dark);
    resize: vertical;
    box-sizing: border-box;
  }
  .sat-reflection__input:focus {
    outline: none;
    border-color: var(--isu-red);
  }
  .sat-reflection__note {
    color: var(--text-light);
    font-size: 0.85em;
    font-style: italic;
    margin-top: 10px;
    margin-bottom: 0;
  }
</style>