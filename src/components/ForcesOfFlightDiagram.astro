<div class="forces-diagram">
  <svg viewBox="0 0 480 380" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Diagram of the four forces of flight acting on a drone">
    <defs>
      <marker id="arrowhead-red" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
        <path d="M0,0 L8,3 L0,6 Z" fill="#c41e3a" />
      </marker>
    </defs>

    <!-- Drone body, viewed from the side -->
    <g transform="translate(240,190)">
      <!-- arms -->
      <line x1="-70" y1="-30" x2="-25" y2="-8" stroke="#333" stroke-width="4" />
      <line x1="70" y1="-30" x2="25" y2="-8" stroke="#333" stroke-width="4" />
      <!-- rotors -->
      <ellipse cx="-70" cy="-30" rx="26" ry="6" fill="#333" opacity="0.85" />
      <ellipse cx="70" cy="-30" rx="26" ry="6" fill="#333" opacity="0.85" />
      <!-- body -->
      <rect x="-30" y="-14" width="60" height="24" rx="8" fill="#c41e3a" />
      <circle cx="0" cy="-2" r="5" fill="#f8c600" />
    </g>

    <!-- Lift: up -->
    <line x1="240" y1="150" x2="240" y2="70" stroke="#c41e3a" stroke-width="4" marker-end="url(#arrowhead-red)" />
    <text x="240" y="55" text-anchor="middle" class="force-label">Lift</text>

    <!-- Weight: down -->
    <line x1="240" y1="220" x2="240" y2="300" stroke="#c41e3a" stroke-width="4" marker-end="url(#arrowhead-red)" />
    <text x="240" y="322" text-anchor="middle" class="force-label">Weight</text>

    <!-- Thrust: forward (right) -->
    <line x1="290" y1="192" x2="400" y2="192" stroke="#c41e3a" stroke-width="4" marker-end="url(#arrowhead-red)" />
    <text x="400" y="215" text-anchor="middle" class="force-label">Thrust</text>

    <!-- Drag: opposing thrust (left) -->
    <line x1="190" y1="192" x2="80" y2="192" stroke="#c41e3a" stroke-width="4" marker-end="url(#arrowhead-red)" />
    <text x="80" y="215" text-anchor="middle" class="force-label">Drag</text>
  </svg>
  <p class="forces-diagram__caption">The four forces of flight act as two opposing pairs: lift vs. weight, and thrust vs. drag.</p>
</div>

<style>
  .forces-diagram {
    margin: 24px auto;
    max-width: 560px;
    text-align: center;
  }
  .forces-diagram svg {
    width: 100%;
    height: auto;
  }
  .force-label {
    font-size: 20px;
    font-weight: 700;
    fill: #1a1a1a;
    font-family: inherit;
  }
  .forces-diagram__caption {
    margin-top: 8px;
    font-size: 0.9em;
    color: var(--text-medium, #666);
    font-style: italic;
  }
</style>