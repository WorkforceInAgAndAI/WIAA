---
const skills = ["Coding", "Robotics", "Agriculture", "Data analysis", "GIS"];
---
<div class="skill-inventory">
  <h4>Activity 26: Skill Inventory</h4>
  <p class="skill-inventory__prompt">Check the skills you have:</p>
  <div class="skill-inventory__checklist">
    {skills.map(s => (
      <label class="skill-inventory__check">
        <input type="checkbox" />
        {s}
      </label>
    ))}
  </div>
  <div class="skill-inventory__item">
    <label>How can you improve one skill?</label>
    <textarea rows="3" placeholder="Type your answer here..."></textarea>
  </div>
</div>

<style is:global>
  .skill-inventory {
    background: white;
    border: 1px solid var(--border-light);
    border-radius: 8px;
    padding: 24px;
    margin: 30px 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }
  .skill-inventory h4 {
    color: var(--isu-red);
    font-size: 1.2em;
    margin-bottom: 8px;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }
  .skill-inventory__prompt {
    color: var(--text-dark);
    margin-bottom: 14px;
  }
  .skill-inventory__checklist {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border-light);
  }
  .skill-inventory__check {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    color: var(--text-dark);
    cursor: pointer;
  }
  .skill-inventory__check input {
    width: 18px;
    height: 18px;
    accent-color: var(--isu-red);
  }
  .skill-inventory__item label {
    display: block;
    font-weight: 600;
    color: var(--isu-red);
    margin-bottom: 8px;
    font-size: 14px;
  }
  .skill-inventory__item textarea {
    width: 100%;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    padding: 12px;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
    font-size: 14px;
    color: var(--text-dark);
    resize: vertical;
    box-sizing: border-box;
  }
</style>