
---
const paths = [
  { id: "disease", label: "Crop Disease Detection", roles: ["AI engineers", "Data scientists", "Agronomists"] },
  { id: "pest", label: "Pest Management", roles: ["Computer vision engineers", "Entomologists", "Data scientists"] },
  { id: "weed", label: "Weed Identification & Targeted Spraying", roles: ["Roboticists", "Control systems engineers", "Software engineers"] },
  { id: "predictive", label: "Predictive Analytics", roles: ["Data scientists", "Statisticians", "Economists"] },
  { id: "autonomous", label: "Autonomous Farm Equipment", roles: ["Robotics engineers", "Control systems engineers", "Safety engineers"] }
];
---
<div class="career-explorer">
  <h4>Explore: Career Paths by Problem Area</h4>
  <p class="career-explorer__prompt">Click a problem area to see the kinds of roles that work on it.</p>
  <div class="career-explorer__grid">
    {paths.map(p => (
      <button class="career-explorer__btn" data-target={p.id}>{p.label}</button>
    ))}
  </div>
  <div class="career-explorer__detail" id="career-explorer-detail">
    <p>Click a problem area above to see the roles involved.</p>
  </div>
</div>

<style is:global>
  .career-explorer {
    background: white;
    border: 1px solid var(--border-light);
    border-radius: 8px;
    padding: 24px;
    margin: 30px 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }
  .career-explorer h4 {
    color: var(--isu-red);
    font-size: 1.2em;
    margin-bottom: 8px;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }
  .career-explorer__prompt {
    color: var(--text-medium);
    margin-bottom: 16px;
  }
  .career-explorer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    margin-bottom: 16px;
  }
  .career-explorer__btn {
    padding: 12px 16px;
    border: 1px solid var(--isu-gold);
    background: white;
    color: var(--isu-red);
    border-radius: 6px;
    cursor: pointer;
    text-align: left;
    font-weight: 600;
    font-family: Georgia, Garamond, 'Times New Roman', serif;
  }
  .career-explorer__btn.active {
    background: var(--isu-red);
    color: white;
  }
  .career-explorer__detail {
    background: #f9f7f4;
    border-radius: 6px;
    padding: 18px;
    color: var(--text-dark);
    line-height: 1.7;
    min-height: 40px;
  }
  .career-explorer__detail ul {
    margin-left: 20px;
    margin-top: 8px;
  }
  .career-explorer__detail li {
    margin-bottom: 4px;
  }
  @media (min-width: 768px) {
    .career-explorer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script define:vars={{ paths }}>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.career-explorer__btn');
    const detail = document.getElementById('career-explorer-detail');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const target = btn.dataset.target;
        const path = paths.find(p => p.id === target);
        if (detail && path) {
          const roleList = path.roles.map(r => `<li>${r}</li>`).join('');
          detail.innerHTML = `<strong>${path.label}</strong><ul>${roleList}</ul>`;
        }
      });
    });
  });
</script>